+    @staticmethod
+    def shift_carla_transform_along_local_x(
+        transform: carla.Transform, distance: float
+    ) -> carla.Transform:
+        """Return a transform shifted along its local longitudinal axis."""
+        forward = transform.get_forward_vector()
+        return carla.Transform(
+            carla.Location(
+                x=transform.location.x + distance * forward.x,
+                y=transform.location.y + distance * forward.y,
+                z=transform.location.z + distance * forward.z,
+            ),
+            transform.rotation,
+        )
