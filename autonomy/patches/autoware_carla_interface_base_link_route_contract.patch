--- a/simulator/autoware_carla_interface/src/autoware_carla_interface/vehicle_status_conversion.py
+++ b/simulator/autoware_carla_interface/src/autoware_carla_interface/vehicle_status_conversion.py
@@ -27,3 +27,19 @@ def carla_yaw_rate_to_ros(angular_velocity_z_deg_per_sec):
     if not math.isfinite(angular_velocity_z_deg_per_sec):
         raise ValueError("CARLA yaw rate must be finite")
     return -math.radians(angular_velocity_z_deg_per_sec)
+
+
+def rear_axle_lateral_velocity(
+    center_lateral_velocity_mps, heading_rate_rad_per_sec, center_to_rear_axle_m
+):
+    """Translate planar lateral velocity from the vehicle center to the rear axle."""
+    values = (
+        center_lateral_velocity_mps,
+        heading_rate_rad_per_sec,
+        center_to_rear_axle_m,
+    )
+    if not all(math.isfinite(value) for value in values):
+        raise ValueError("rear-axle velocity inputs must be finite")
+    if center_to_rear_axle_m < 0.0:
+        raise ValueError("center-to-rear-axle distance must be non-negative")
+    return center_lateral_velocity_mps - center_to_rear_axle_m * heading_rate_rad_per_sec
