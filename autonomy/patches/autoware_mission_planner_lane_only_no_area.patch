+  area_entry.attributes()["type"] = "virtual";
+  area_exit.attributes()["type"] = "virtual";
+
+  lanelet::Area area(kAreaId, lanelet::LineStrings3d{area_entry, area_left, area_exit, area_right});
+  area.attributes()["subtype"] = "parking";
+  area.attributes()["participant:vehicle"] = "yes";
+
+  auto map = std::make_shared<lanelet::LaneletMap>();
+  map->add(make_road_lanelet(kAreaEntryLaneId, entry_left, entry_right));
+  map->add(area);
+  map->add(make_road_lanelet(kAreaExitLaneId, exit_left, exit_right));
