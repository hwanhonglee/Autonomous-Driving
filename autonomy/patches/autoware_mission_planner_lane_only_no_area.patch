+TEST_F(DefaultPlannerTest, planTown05TurnWithoutAreas)
+{
+  const auto map = make_town05_turn_map();
+  ASSERT_TRUE(map->areaLayer.empty());
+  for (const auto id : {kTown05EntryLaneId, kTown05TurnLaneId, kTown05ExitLaneId}) {
+    const auto lanelet = map->laneletLayer.get(id);
+    ASSERT_GE(lanelet.centerline().size(), 2U);
+    EXPECT_TRUE(std::isfinite(lanelet::geometry::length2d(lanelet)));
+    EXPECT_GT(lanelet::geometry::length2d(lanelet), 0.0);
+    for (const auto & point : lanelet.centerline()) {
+      EXPECT_TRUE(std::isfinite(point.x()));
+      EXPECT_TRUE(std::isfinite(point.y()));
+      EXPECT_TRUE(std::isfinite(point.z()));
+    }
+  }
+  planner_.set_test_map(map);
+  planner_.set_allow_area(false);
+
+  RoutePoints route_points{
+    autoware::test_utils::createPose(2.0, 5.0, 0.0, 0.0, 0.0, 1.5707963267948966),
+    autoware::test_utils::createPose(-45.0, 38.0, 0.0, 0.0, 0.0, 3.141592653589793)};
+
+  const auto route = planner_.plan(route_points);
+  const std::vector<lanelet::Id> expected_ids{
+    kTown05EntryLaneId, kTown05TurnLaneId, kTown05ExitLaneId};
+  ASSERT_EQ(route.segments.size(), expected_ids.size());
+  for (std::size_t i = 0; i < expected_ids.size(); ++i) {
+    EXPECT_EQ(route.segments.at(i).preferred_primitive.id, expected_ids.at(i));
+    EXPECT_EQ(route.segments.at(i).preferred_primitive.primitive_type, "lane");
+  }
+}
