+lanelet::Lanelet make_road_lanelet(
+  const lanelet::Id id, const lanelet::LineString3d & left, const lanelet::LineString3d & right)
+{
+  lanelet::Lanelet lanelet(id, left, right);
+  lanelet.attributes()["subtype"] = "road";
+  lanelet.attributes()["participant:vehicle"] = "yes";
+  return lanelet;
+}
+
+lanelet::LaneletMapPtr make_town05_turn_map()
+{
+  const lanelet::Point3d entry_left_start(1, 0.0, 0.0, 0.0);
+  const lanelet::Point3d entry_left_end(2, 0.0, 20.0, 0.0);
+  const lanelet::Point3d entry_right_start(3, 4.0, 0.0, 0.0);
+  const lanelet::Point3d entry_right_end(4, 4.0, 20.0, 0.0);
+
+  const lanelet::Point3d turn_left_start_duplicate(11, 0.0, 20.0, 0.0);
+  const lanelet::Point3d turn_left_middle(5, -4.0, 28.0, 0.0);
+  const lanelet::Point3d turn_left_end(6, -20.0, 36.0, 0.0);
+  const lanelet::Point3d turn_right_middle(7, 0.0, 32.0, 0.0);
+  const lanelet::Point3d turn_right_end(8, -20.0, 40.0, 0.0);
+
+  const lanelet::Point3d exit_left_end(9, -50.0, 36.0, 0.0);
+  const lanelet::Point3d exit_right_end(10, -50.0, 40.0, 0.0);
+
+  const lanelet::LineString3d entry_left(101, {entry_left_start, entry_left_end});
+  const lanelet::LineString3d entry_right(102, {entry_right_start, entry_right_end});
+  const lanelet::LineString3d turn_left(
+    103, {entry_left_end, turn_left_start_duplicate, turn_left_middle, turn_left_end});
+  const lanelet::LineString3d turn_right(104, {entry_right_end, turn_right_middle, turn_right_end});
+  const lanelet::LineString3d exit_left(105, {turn_left_end, exit_left_end});
+  const lanelet::LineString3d exit_right(106, {turn_right_end, exit_right_end});
+
+  auto map = std::make_shared<lanelet::LaneletMap>();
+  map->add(make_road_lanelet(kTown05EntryLaneId, entry_left, entry_right));
+  map->add(make_road_lanelet(kTown05TurnLaneId, turn_left, turn_right));
+  map->add(make_road_lanelet(kTown05ExitLaneId, exit_left, exit_right));
+  lanelet::utils::overwriteLaneletsCenterline(map, 1.0, true);
+  return map;
+}
