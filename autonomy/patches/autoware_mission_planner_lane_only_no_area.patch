+TEST_F(DefaultPlannerTest, planThroughAreaWhenEnabled)
+{
+  const auto map = make_lane_area_lane_map();
+  ASSERT_FALSE(map->areaLayer.empty());
+  planner_.set_test_map(map);
+  planner_.set_allow_area(true);
+
+  const auto & route_handler = planner_.getRouteHandler();
+  const auto lanelet_map = route_handler.getLaneletMapPtr();
+  const auto entry_lanelet = lanelet_map->laneletLayer.get(kAreaEntryLaneId);
+  const auto area = lanelet_map->areaLayer.get(kAreaId);
+  const auto exit_lanelet = lanelet_map->laneletLayer.get(kAreaExitLaneId);
+  const auto traffic_rules = route_handler.getTrafficRulesPtr();
+  ASSERT_TRUE(traffic_rules->canPass(area));
+  ASSERT_TRUE(lanelet::geometry::follows(entry_lanelet, area));
+  ASSERT_TRUE(lanelet::geometry::follows(area, exit_lanelet));
+  ASSERT_TRUE(traffic_rules->canPass(entry_lanelet, area));
+  ASSERT_TRUE(traffic_rules->canPass(area, exit_lanelet));
+
+  RoutePoints route_points{
+    autoware::test_utils::createPose(2.0, 5.0, 0.0, 0.0, 0.0, 1.5707963267948966),
+    autoware::test_utils::createPose(2.0, 25.0, 0.0, 0.0, 0.0, 1.5707963267948966)};
+
+  const auto route = planner_.plan(route_points);
+  const std::vector<lanelet::Id> expected_ids{kAreaEntryLaneId, kAreaId, kAreaExitLaneId};
+  const std::vector<std::string> expected_types{"lane", "area", "lane"};
+  ASSERT_EQ(route.segments.size(), expected_ids.size());
+  for (std::size_t i = 0; i < expected_ids.size(); ++i) {
+    EXPECT_EQ(route.segments.at(i).preferred_primitive.id, expected_ids.at(i));
+    EXPECT_EQ(route.segments.at(i).preferred_primitive.primitive_type, expected_types.at(i));
+  }
