+lanelet::LaneletMapPtr make_non_finite_town05_route_map()
+{
+  const lanelet::Point3d left_0(1001, 0.0, 0.0, 0.0);
+  const lanelet::Point3d left_1(1002, 0.0, 10.0, 0.0);
+  const lanelet::Point3d left_2(1003, 0.0, 20.0, 0.0);
+  const lanelet::Point3d left_3(1004, 0.0, 30.0, 0.0);
+  const lanelet::Point3d right_0(2001, 4.0, 0.0, 0.0);
+  const lanelet::Point3d right_1(2002, 4.0, 10.0, 0.0);
+  const lanelet::Point3d right_2(2003, 4.0, 20.0, 0.0);
+  const lanelet::Point3d right_3(2004, 4.0, 30.0, 0.0);
+
+  auto entry = make_road_lanelet(
+    22775, lanelet::LineString3d(3001, {left_0, left_1}),
+    lanelet::LineString3d(3002, {right_0, right_1}));
+  auto turn = make_road_lanelet(
+    28467, lanelet::LineString3d(3003, {left_1, left_2}),
+    lanelet::LineString3d(3004, {right_1, right_2}));
+  auto exit = make_road_lanelet(
+    1850, lanelet::LineString3d(3005, {left_2, left_3}),
+    lanelet::LineString3d(3006, {right_2, right_3}));
+
+  const double nan = std::numeric_limits<double>::quiet_NaN();
+  turn.setCenterline(lanelet::LineString3d(
+    4001, {lanelet::Point3d(4002, 2.0, 10.0, 0.0), lanelet::Point3d(4003, nan, nan, nan)}));
+
+  auto map = std::make_shared<lanelet::LaneletMap>();
+  map->add(entry);
+  map->add(turn);
+  map->add(exit);
+  return map;
+}
