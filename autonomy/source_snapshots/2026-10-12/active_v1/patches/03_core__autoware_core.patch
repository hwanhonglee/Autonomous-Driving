+
+from importlib.machinery import SourceFileLoader
+from importlib.util import module_from_spec
+from importlib.util import spec_from_loader
+from pathlib import Path
+from unittest.mock import Mock
+
+import pytest
+from rclpy.executors import ExternalShutdownException
+
+
+def load_map_hash_generator():
+    script = Path(__file__).parents[1] / "script" / "map_hash_generator"
+    loader = SourceFileLoader("map_hash_generator_under_test", str(script))
+    spec = spec_from_loader(loader.name, loader)
+    module = module_from_spec(spec)
+    loader.exec_module(module)
+    return module
+
+
+@pytest.mark.parametrize("spin_exception", [KeyboardInterrupt(), ExternalShutdownException()])
+def test_main_handles_expected_executor_shutdown(monkeypatch, spin_exception):
+    module = load_map_hash_generator()
+    node = Mock()
+    init = Mock()
+    spin = Mock(side_effect=spin_exception)
+    shutdown = Mock()
+
+    monkeypatch.setattr(module.rclpy, "init", init)
+    monkeypatch.setattr(module, "MapHashGenerator", Mock(return_value=node))
+    monkeypatch.setattr(module.rclpy, "spin", spin)
+    monkeypatch.setattr(module.rclpy, "ok", Mock(return_value=False))
+    monkeypatch.setattr(module.rclpy, "shutdown", shutdown)
+
+    module.main(args=["--ros-args"])
+
+    init.assert_called_once_with(args=["--ros-args"])
+    spin.assert_called_once_with(node)
+    node.destroy_node.assert_called_once_with()
+    shutdown.assert_not_called()
+
+
+def test_main_shuts_down_live_context_after_spin_returns(monkeypatch):
+    module = load_map_hash_generator()
+    node = Mock()
+    shutdown = Mock()
+
+    monkeypatch.setattr(module.rclpy, "init", Mock())
+    monkeypatch.setattr(module, "MapHashGenerator", Mock(return_value=node))
+    monkeypatch.setattr(module.rclpy, "spin", Mock())
+    monkeypatch.setattr(module.rclpy, "ok", Mock(return_value=True))
+    monkeypatch.setattr(module.rclpy, "shutdown", shutdown)
+
+    module.main()
+
+    node.destroy_node.assert_called_once_with()
+    shutdown.assert_called_once_with()
