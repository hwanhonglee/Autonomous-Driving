+from dataclasses import dataclass
+import math
+from typing import Optional
+from typing import Sequence
+
+
+DEFAULT_GOAL_STOP_PRESERVE_DISTANCE_M = 0.5
+
+
+@dataclass(frozen=True)
+class GoalStopGuardResult:
+    velocities: tuple[float, ...]
+    active: bool
+    reason: str
+    stop_distance_m: Optional[float] = None
+    floored_points: int = 0
+    tail_start_index: Optional[int] = None
+
+
+def condition_distant_goal_stop_reference(
+    positions: Sequence[Sequence[float]],
+    velocities: Sequence[float],
+    nearest_index: int,
+    goal_position: Optional[Sequence[float]],
+    *,
+    enabled: bool,
+    zero_speed_threshold_mps: float,
+    preserve_distance_m: float,
+    minimum_speed_mps: float,
+    goal_match_tolerance_m: float,
+) -> GoalStopGuardResult:
+    """Keep a distant terminal stop tail from dominating Smart MPC's time horizon.
+
+    Only the controller's private velocity reference is returned. The input
+    trajectory remains untouched, and the original reference is restored near
+    the stop point so the normal goal-stop behavior remains authoritative.
+    """
+    original = tuple(float(value) for value in velocities)
+    if not enabled:
+        return GoalStopGuardResult(original, False, "disabled")
+
+    if (
+        zero_speed_threshold_mps < 0.0
+        or preserve_distance_m < 0.0
+        or minimum_speed_mps <= zero_speed_threshold_mps
+        or goal_match_tolerance_m < 0.0
+    ):
+        raise ValueError("invalid goal-stop guard configuration")
+
+    if len(positions) != len(original) or len(original) < 2:
+        return GoalStopGuardResult(original, False, "invalid_trajectory")
+    if nearest_index < 0 or nearest_index >= len(original):
+        return GoalStopGuardResult(original, False, "invalid_nearest_index")
+    if goal_position is None or len(goal_position) < 2:
+        return GoalStopGuardResult(original, False, "goal_unavailable")
+
+    try:
+        xy = tuple((float(position[0]), float(position[1])) for position in positions)
+        goal_xy = (float(goal_position[0]), float(goal_position[1]))
+    except (IndexError, TypeError, ValueError):
+        return GoalStopGuardResult(original, False, "invalid_geometry")
+
+    if not all(
+        math.isfinite(value)
+        for position in xy
+        for value in position
+    ) or not all(math.isfinite(value) for value in (*original, *goal_xy)):
+        return GoalStopGuardResult(original, False, "non_finite_input")
+
+    tail_start = len(original)
+    while tail_start > 0 and abs(original[tail_start - 1]) <= zero_speed_threshold_mps:
+        tail_start -= 1
+    if tail_start == len(original):
+        return GoalStopGuardResult(original, False, "no_terminal_zero_tail")
+    if tail_start <= nearest_index:
+        return GoalStopGuardResult(
+            original,
+            False,
+            "at_terminal_stop",
+            stop_distance_m=0.0,
+            tail_start_index=tail_start,
+        )
+
+    final_goal_distance = math.hypot(xy[-1][0] - goal_xy[0], xy[-1][1] - goal_xy[1])
+    stop_goal_distance = math.hypot(
+        xy[tail_start][0] - goal_xy[0], xy[tail_start][1] - goal_xy[1]
+    )
+    if (
+        final_goal_distance > goal_match_tolerance_m
+        or stop_goal_distance > goal_match_tolerance_m
+    ):
+        return GoalStopGuardResult(
+            original,
+            False,
+            "stop_point_goal_mismatch",
+            tail_start_index=tail_start,
+        )
+
+    # Reverse and direction-changing trajectories need their signed velocity
+    # profile intact; this guard is deliberately limited to forward goal stops.
+    if any(
+        value < -zero_speed_threshold_mps
+        for value in original[nearest_index:tail_start]
+    ):
+        return GoalStopGuardResult(
+            original,
+            False,
+            "reverse_trajectory",
+            tail_start_index=tail_start,
+        )
+
+    if any(
+        abs(value) <= zero_speed_threshold_mps
+        for value in original[nearest_index:tail_start]
+    ):
+        return GoalStopGuardResult(
+            original,
+            False,
+            "non_terminal_zero_speed",
+            tail_start_index=tail_start,
+        )
+
+    speed_increase_tolerance_mps = max(zero_speed_threshold_mps, 0.05)
+    if any(
+        following > current + speed_increase_tolerance_mps
+        for current, following in zip(
+            original[nearest_index:tail_start],
+            original[nearest_index + 1 : tail_start],
+        )
+    ):
+        return GoalStopGuardResult(
+            original,
+            False,
+            "non_terminal_deceleration_profile",
+            tail_start_index=tail_start,
+        )
+
+    stop_distance = sum(
+        math.hypot(xy[index + 1][0] - xy[index][0], xy[index + 1][1] - xy[index][1])
+        for index in range(nearest_index, tail_start)
+    )
+    if stop_distance <= preserve_distance_m:
+        return GoalStopGuardResult(
+            original,
+            False,
+            "inside_preserve_distance",
+            stop_distance_m=stop_distance,
+            tail_start_index=tail_start,
+        )
+
+    conditioned = list(original)
+    floored_points = 0
+    for index in range(nearest_index, len(conditioned)):
+        if conditioned[index] < minimum_speed_mps:
+            conditioned[index] = minimum_speed_mps
+            floored_points += 1
+
+    if floored_points == 0:
+        return GoalStopGuardResult(
+            original,
+            False,
+            "no_velocity_below_floor",
+            stop_distance_m=stop_distance,
+            tail_start_index=tail_start,
+        )
+    return GoalStopGuardResult(
+        tuple(conditioned),
+        True,
+        "distant_goal_stop_guarded",
+        stop_distance_m=stop_distance,
+        floored_points=floored_points,
+        tail_start_index=tail_start,
+    )
