+  constexpr std::int64_t half_tolerance_ns = 500000LL;
+
+  const auto run_with_order = [&](const bool earlier_first) {
+    auto buffer = make_buffer();
+    set_camera_infos(buffer);
+    for (std::size_t camera_id = 0; camera_id < camera_count; ++camera_id) {
+      if (camera_id != 1U) {
+        buffer.set_image(camera_id, make_image(anchor_stamp_ns));
+      }
+    }
+    const auto earlier = make_image(anchor_stamp_ns - half_tolerance_ns);
+    const auto later = make_image(anchor_stamp_ns + half_tolerance_ns);
+    buffer.set_image(1U, earlier_first ? earlier : later);
+    EXPECT_FALSE(buffer.take_ready_frame().frame.has_value());
+    buffer.set_image(1U, earlier_first ? later : earlier);
+    EXPECT_FALSE(buffer.take_ready_frame().frame.has_value());
+    buffer.set_kinematic_state(make_odometry(anchor_stamp_ns));
+    EXPECT_FALSE(buffer.take_ready_frame().frame.has_value());
+    buffer.set_acceleration(make_acceleration(anchor_stamp_ns));
+    return buffer.take_ready_frame();
+  };
+
+  const auto earlier_first = run_with_order(true);
+  const auto later_first = run_with_order(false);
+  ASSERT_TRUE(earlier_first.frame.has_value());
+  ASSERT_TRUE(later_first.frame.has_value());
+  EXPECT_EQ(earlier_first.match_kind, FrameAssemblyResult::MatchKind::APPROXIMATE);
+  EXPECT_EQ(later_first.match_kind, FrameAssemblyResult::MatchKind::APPROXIMATE);
+  EXPECT_EQ(
+    earlier_first.frame->images[1]->header.stamp, make_stamp(anchor_stamp_ns - half_tolerance_ns));
+  EXPECT_EQ(
+    later_first.frame->images[1]->header.stamp, make_stamp(anchor_stamp_ns - half_tolerance_ns));
