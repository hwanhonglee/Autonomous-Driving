+VadInputTopicData SynchronizedFrameBuffer::materialize_exact_frame(
+  const VadInputTopicData & image_frame) const
+{
+  auto frame = image_frame;
+  frame.camera_infos = camera_infos_;
+  const auto & anchor_image = frame.images[anchor_camera_id_];
+  if (anchor_image) {
+    const auto anchor_stamp_ns = stamp_to_nanoseconds(anchor_image->header.stamp);
+    frame.kinematic_state = find_latest_causal_kinematic_state(anchor_stamp_ns);
+    frame.acceleration = find_latest_causal_acceleration(anchor_stamp_ns);
+  }
+  return frame;
+}
