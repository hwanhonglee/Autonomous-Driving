+FrameMailboxSubmitResult LatestFrameMailbox::submit(FrameAssemblyResult frame)
+{
+  if (!frame.frame.has_value() || !frame.status.ready()) {
+    ++counters_.rejected_invalid;
+    return FrameMailboxSubmitResult::REJECTED_INVALID;
+  }
+
+  const auto source_stamp_ns = frame.status.source_stamp_ns;
+  if (
+    (last_taken_source_stamp_ns_.has_value() && source_stamp_ns <= *last_taken_source_stamp_ns_) ||
+    (pending_frame_.has_value() && source_stamp_ns <= pending_frame_->status.source_stamp_ns)) {
+    ++counters_.rejected_old;
+    return FrameMailboxSubmitResult::REJECTED_OLD;
+  }
+
+  const bool replaces_pending = pending_frame_.has_value();
+  pending_frame_ = std::move(frame);
+  ++counters_.submitted;
+  if (replaces_pending) {
+    ++counters_.coalesced_drops;
+    return FrameMailboxSubmitResult::REPLACED_OLDER_PENDING;
+  }
+  return FrameMailboxSubmitResult::STORED;
+}
+
+std::optional<FrameAssemblyResult> LatestFrameMailbox::take_latest()
+{
+  if (!pending_frame_.has_value()) {
+    return std::nullopt;
+  }
+
+  auto result = std::move(pending_frame_);
+  pending_frame_.reset();
+  last_taken_source_stamp_ns_ = result->status.source_stamp_ns;
+  ++counters_.taken;
+  return result;
+}
