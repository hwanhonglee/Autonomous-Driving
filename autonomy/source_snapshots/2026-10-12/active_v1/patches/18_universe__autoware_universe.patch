+bool hasVerticalOverlap(
+  const PredictedObject & object, const double minimum_height, const double maximum_height)
+{
+  const double center_height = object.kinematics.initial_pose_with_covariance.pose.position.z;
+  const auto & orientation = object.kinematics.initial_pose_with_covariance.pose.orientation;
+
+  if (
+    !std::isfinite(center_height) || !std::isfinite(minimum_height) ||
+    !std::isfinite(maximum_height) || minimum_height > maximum_height) {
+    return true;
+  }
+
+  const auto normalized_orientation = normalizeQuaternion(orientation);
+  if (!normalized_orientation.has_value()) {
+    return true;
+  }
+
+  const auto vertical_half_extent = [&]() -> std::optional<double> {
+    if (object.shape.type == autoware_perception_msgs::msg::Shape::BOUNDING_BOX) {
+      return getBoundingBoxVerticalHalfExtent(object.shape, normalized_orientation.value());
+    }
+
+    if (
+      object.shape.type != autoware_perception_msgs::msg::Shape::CYLINDER &&
+      object.shape.type != autoware_perception_msgs::msg::Shape::POLYGON) {
+      return std::nullopt;
+    }
+
+    // dimensions.z is the established vertical-height contract for cylinders and polygonal
+    // prisms. Without their full 3D geometry, it is safe to prove separation only for yaw-only
+    // orientations; tilted or otherwise uncertain non-box shapes remain collision candidates.
+    const double object_height = object.shape.dimensions.z;
+    if (
+      !std::isfinite(object_height) || object_height <= 0.0 ||
+      !isYawOnly(normalized_orientation.value())) {
+      return std::nullopt;
+    }
+    return 0.5 * object_height;
+  }();
+  if (!vertical_half_extent.has_value()) {
+    return true;
+  }
+
+  const double object_minimum_height = center_height - vertical_half_extent.value();
+  const double object_maximum_height = center_height + vertical_half_extent.value();
+  if (!std::isfinite(object_minimum_height) || !std::isfinite(object_maximum_height)) {
+    return true;
+  }
+
+  return object_minimum_height <= maximum_height && object_maximum_height >= minimum_height;
+}
