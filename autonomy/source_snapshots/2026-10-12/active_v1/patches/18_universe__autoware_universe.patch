+
+namespace autoware::tensorrt_vad::vad_interface
+{
+namespace
+{
+
+constexpr float kPi = 3.14159265358979323846f;
+
+VadInterfaceConfig make_config(const std::string & mode)
+{
+  return VadInterfaceConfig(
+    640, 384, {-30.0, -16.0, -0.355, 30.0, 16.0, 4.645}, mode, 3, {}, {}, {}, {});
+}
+
+CanBusData make_can_bus(const float x, const float y, const float yaw)
+{
+  CanBusData can_bus(18, 0.0f);
+  can_bus[0] = x;
+  can_bus[1] = y;
+  can_bus[16] = yaw;
+  return can_bus;
+}
+
+ShiftData shift_for_local_motion(
+  const std::string & mode, const float yaw, const float forward, const float left)
+{
+  const auto config = make_config(mode);
+  const CoordinateTransformer transformer(nullptr);
+  const InputBEVShiftConverter converter(transformer, config);
+  const auto previous = make_can_bus(10.0f, 20.0f, yaw);
+  const float delta_x = std::cos(yaw) * forward - std::sin(yaw) * left;
+  const float delta_y = std::sin(yaw) * forward + std::cos(yaw) * left;
+  const auto current = make_can_bus(10.0f + delta_x, 20.0f + delta_y, yaw);
+  return converter.process_shift(current, previous);
+}
+
+class BEVShiftHeadingTest : public testing::TestWithParam<float>
+{
+};
+
+TEST_P(BEVShiftHeadingTest, RosCorrectedMapsForwardAndLeftToOnnxXY)
+{
+  const float yaw = GetParam();
+  const auto forward = shift_for_local_motion("ros_corrected", yaw, 3.0f, 0.0f);
+  const auto left = shift_for_local_motion("ros_corrected", yaw, 0.0f, 3.2f);
+
+  ASSERT_EQ(forward.size(), 2U);
+  EXPECT_NEAR(forward[0], 3.0f / 60.0f, 1e-6f);
+  EXPECT_NEAR(forward[1], 0.0f, 1e-6f);
+  ASSERT_EQ(left.size(), 2U);
+  EXPECT_NEAR(left[0], 0.0f, 1e-6f);
+  EXPECT_NEAR(left[1], 3.2f / 32.0f, 1e-6f);
+}
+
+TEST_P(BEVShiftHeadingTest, LegacyPreservesRightForwardAxisOrder)
+{
+  const float yaw = GetParam();
+  const auto forward = shift_for_local_motion("legacy", yaw, 3.0f, 0.0f);
+  const auto left = shift_for_local_motion("legacy", yaw, 0.0f, 3.2f);
+
+  ASSERT_EQ(forward.size(), 2U);
+  EXPECT_NEAR(forward[0], 0.0f, 1e-6f);
+  EXPECT_NEAR(forward[1], 3.0f / 32.0f, 1e-6f);
+  ASSERT_EQ(left.size(), 2U);
+  EXPECT_NEAR(left[0], -3.2f / 60.0f, 1e-6f);
+  EXPECT_NEAR(left[1], 0.0f, 1e-6f);
+}
+
+INSTANTIATE_TEST_SUITE_P(
+  YawZeroPlusAndMinusNinety, BEVShiftHeadingTest, testing::Values(0.0f, kPi / 2.0f, -kPi / 2.0f));
+
+TEST(BEVShiftContract, ZeroModeDisablesTranslationAtAnyHeading)
+{
+  const auto shift = shift_for_local_motion("zero", kPi / 3.0f, 2.0f, -1.0f);
+  EXPECT_FLOAT_EQ(shift[0], 0.0f);
+  EXPECT_FLOAT_EQ(shift[1], 0.0f);
+}
+
+TEST(BEVShiftContract, FirstFrameIsZeroForEveryMode)
+{
+  const CoordinateTransformer transformer(nullptr);
+  for (const auto & mode : {"legacy", "ros_corrected", "zero"}) {
+    const auto config = make_config(mode);
+    const InputBEVShiftConverter converter(transformer, config);
+    const auto shift = converter.process_shift(make_can_bus(10.0f, 20.0f, 0.5f), {});
+    EXPECT_FLOAT_EQ(shift[0], 0.0f);
+    EXPECT_FLOAT_EQ(shift[1], 0.0f);
+  }
+}
+
+TEST(BEVShiftContract, RejectsUnknownMode)
+{
+  const auto config = make_config("swapped");
+  const CoordinateTransformer transformer(nullptr);
+  EXPECT_THROW(InputBEVShiftConverter(transformer, config), std::invalid_argument);
+}
+
+}  // namespace
+}  // namespace autoware::tensorrt_vad::vad_interface
