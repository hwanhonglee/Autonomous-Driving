+
+  auto velocity = std::make_shared<VelocityReport>();
+  velocity->longitudinal_velocity = longitudinal_velocity;
+  aeb_node_->current_velocity_ptr_ = velocity;
+
+  PredictedObject object;
+  object.shape.type = autoware_perception_msgs::msg::Shape::BOUNDING_BOX;
+  object.shape.dimensions.x = 5.039;
+  object.shape.dimensions.y = 2.033;
+  object.shape.dimensions.z = 1.484;
+  object.kinematics.initial_pose_with_covariance.pose.position.x = -2.089;
+  object.kinematics.initial_pose_with_covariance.pose.position.y = -3.092;
+  object.kinematics.initial_pose_with_covariance.pose.position.z = 0.895;
+  object.kinematics.initial_pose_with_covariance.pose.orientation =
+    autoware_utils::create_quaternion_from_yaw(-1.659);
+
+  auto predicted_objects = std::make_shared<PredictedObjects>();
+  predicted_objects->header.frame_id = "base_link";
+  predicted_objects->objects.push_back(object);
+  aeb_node_->predicted_objects_ptr_ = predicted_objects;
+
+  std::vector<ObjectData> candidates;
+  aeb_node_->createObjectDataUsingPredictedObjects(ego_path, ego_polygons, candidates);
+  EXPECT_TRUE(candidates.empty());
+
+  // A long object crossing the base_link origin still has forward intersection points and must
+  // remain an immediate AEB candidate; the rear filter must not discard the object as a whole.
+  auto & crossing_object = predicted_objects->objects.front();
+  crossing_object.shape.dimensions.x = 4.0;
+  crossing_object.shape.dimensions.y = 1.0;
+  crossing_object.shape.dimensions.z = 1.0;
+  crossing_object.kinematics.initial_pose_with_covariance.pose.position.x = 0.0;
+  crossing_object.kinematics.initial_pose_with_covariance.pose.position.y = 0.0;
+  crossing_object.kinematics.initial_pose_with_covariance.pose.position.z = 0.5;
+  crossing_object.kinematics.initial_pose_with_covariance.pose.orientation.w = 1.0;
+  crossing_object.kinematics.initial_pose_with_covariance.pose.orientation.z = 0.0;
+  candidates.clear();
+  aeb_node_->createObjectDataUsingPredictedObjects(ego_path, ego_polygons, candidates);
+  EXPECT_FALSE(candidates.empty());
+}
