+TEST_F(TestAEB, PredictedObjectCollisionCandidatesRejectObjectsBehindDrivingPath)
+{
+  auto velocity = std::make_shared<VelocityReport>();
+  aeb_node_->current_velocity_ptr_ = velocity;
+
+  PredictedObject object;
+  object.shape.type = autoware_perception_msgs::msg::Shape::BOUNDING_BOX;
+  object.shape.dimensions.x = 0.5;
+  object.shape.dimensions.y = 1.0;
+  object.shape.dimensions.z = 1.0;
+  object.kinematics.initial_pose_with_covariance.pose.position.z = 0.5;
+  object.kinematics.initial_pose_with_covariance.pose.orientation.w = 1.0;
+
+  auto predicted_objects = std::make_shared<PredictedObjects>();
+  predicted_objects->header.frame_id = "base_link";
+  predicted_objects->objects.push_back(object);
+  aeb_node_->predicted_objects_ptr_ = predicted_objects;
+
+  const auto collect_candidates = [&](const double longitudinal_velocity, const double object_x) {
+    velocity->longitudinal_velocity = longitudinal_velocity;
+    predicted_objects->objects.front()
+      .kinematics.initial_pose_with_covariance.pose.position.x = object_x;
+    const auto ego_path = aeb_node_->generateEgoPath(longitudinal_velocity, 0.0);
+    const auto ego_polygons = aeb_node_->generatePathFootprint(ego_path, 0.0);
+    EXPECT_FALSE(ego_path.empty());
+    EXPECT_FALSE(ego_polygons.empty());
+    std::vector<ObjectData> candidates;
+    aeb_node_->createObjectDataUsingPredictedObjects(ego_path, ego_polygons, candidates);
+    return candidates;
+  };
+
+  // The object overlaps the current rear footprint, but its entire polygon is behind the
+  // base_link origin in the driving direction. The pointcloud path already rejects this case.
+  EXPECT_TRUE(collect_candidates(3.0, -1.0).empty());
+  EXPECT_FALSE(collect_candidates(3.0, 1.0).empty());
+
+  // Signed arc length follows the path, so the same contract also holds while reversing.
+  EXPECT_TRUE(collect_candidates(-3.0, 1.0).empty());
+  EXPECT_FALSE(collect_candidates(-3.0, -2.0).empty());
+}
