+
+namespace autoware::tensorrt_vad
+{
+namespace
+{
+
+constexpr std::size_t camera_count = 6;
+
+builtin_interfaces::msg::Time make_stamp(const std::int64_t stamp_ns)
+{
+  builtin_interfaces::msg::Time stamp;
+  stamp.sec = static_cast<std::int32_t>(stamp_ns / 1000000000LL);
+  stamp.nanosec = static_cast<std::uint32_t>(stamp_ns % 1000000000LL);
+  return stamp;
+}
+
+sensor_msgs::msg::Image::ConstSharedPtr make_image(const std::int64_t stamp_ns)
+{
+  auto msg = std::make_shared<sensor_msgs::msg::Image>();
+  msg->header.stamp = make_stamp(stamp_ns);
+  return msg;
+}
+
+sensor_msgs::msg::CameraInfo::ConstSharedPtr make_camera_info()
+{
+  return std::make_shared<sensor_msgs::msg::CameraInfo>();
+}
+
+nav_msgs::msg::Odometry::ConstSharedPtr make_odometry(const std::int64_t stamp_ns)
+{
+  auto msg = std::make_shared<nav_msgs::msg::Odometry>();
+  msg->header.stamp = make_stamp(stamp_ns);
+  return msg;
+}
+
+geometry_msgs::msg::AccelWithCovarianceStamped::ConstSharedPtr make_acceleration(
+  const std::int64_t stamp_ns)
+{
+  auto msg = std::make_shared<geometry_msgs::msg::AccelWithCovarianceStamped>();
+  msg->header.stamp = make_stamp(stamp_ns);
+  return msg;
+}
+
+SynchronizedFrameBuffer make_buffer(
+  const std::size_t max_pending_frames = 8U, const double camera_sync_tolerance_ms = 1.0,
+  const std::size_t max_vehicle_state_samples = 64U)
+{
+  return SynchronizedFrameBuffer(
+    camera_count,
+    std::make_unique<FrontCriticalSynchronizationStrategy>(0, 500.0, camera_sync_tolerance_ms),
+    max_pending_frames, max_vehicle_state_samples);
+}
+
+void set_camera_infos(SynchronizedFrameBuffer & buffer)
+{
+  for (std::size_t camera_id = 0; camera_id < camera_count; ++camera_id) {
+    buffer.set_camera_info(camera_id, make_camera_info());
+  }
+}
+
+void set_dynamic_frame(SynchronizedFrameBuffer & buffer, const std::int64_t stamp_ns)
+{
+  for (std::size_t camera_id = 0; camera_id < camera_count; ++camera_id) {
+    buffer.set_image(camera_id, make_image(stamp_ns));
+  }
+  buffer.set_kinematic_state(make_odometry(stamp_ns));
+  buffer.set_acceleration(make_acceleration(stamp_ns));
+}
+
+std::vector<FrameAssemblyResult> feed_dynamic_frame_as_callbacks(
+  SynchronizedFrameBuffer & buffer, const std::int64_t stamp_ns)
+{
+  std::vector<FrameAssemblyResult> complete_frames;
+  const auto capture_if_ready = [&buffer, &complete_frames]() {
+    auto result = buffer.take_ready_frame();
+    if (result.frame.has_value()) {
+      complete_frames.push_back(std::move(result));
+    }
+  };
+
+  buffer.set_kinematic_state(make_odometry(stamp_ns));
+  capture_if_ready();
+  for (const auto camera_id : std::array<std::size_t, camera_count>{0, 2, 4, 1, 3, 5}) {
+    buffer.set_image(camera_id, make_image(stamp_ns));
+    capture_if_ready();
+  }
+  buffer.set_acceleration(make_acceleration(stamp_ns));
+  capture_if_ready();
+  return complete_frames;
+}
+
+}  // namespace
+
+TEST(FrameAssembly, DoesNotConsumeIncompleteFrameAndCachesCameraInfo)
+{
+  auto buffer = make_buffer();
+  set_camera_infos(buffer);
+  constexpr std::int64_t first_stamp_ns = 1000000000LL;
+  buffer.set_kinematic_state(make_odometry(first_stamp_ns));
+  buffer.set_acceleration(make_acceleration(first_stamp_ns));
+  for (std::size_t camera_id = 0; camera_id < camera_count - 1; ++camera_id) {
+    buffer.set_image(camera_id, make_image(first_stamp_ns));
+  }
+
+  const auto incomplete = buffer.take_ready_frame();
+  EXPECT_FALSE(incomplete.frame.has_value());
+  EXPECT_EQ(incomplete.status.reason, FrameAssemblyReason::MISSING_IMAGES);
+  EXPECT_EQ(incomplete.status.missing_image_mask, std::uint64_t{1} << (camera_count - 1));
+  EXPECT_EQ(buffer.pending_frame_count(), 1U);
+  EXPECT_EQ(buffer.oldest_pending_source_stamp_ns(), first_stamp_ns);
+  EXPECT_EQ(buffer.newest_pending_source_stamp_ns(), first_stamp_ns);
+
+  buffer.set_image(camera_count - 1, make_image(first_stamp_ns));
+  const auto first_frame = buffer.take_ready_frame();
+  ASSERT_TRUE(first_frame.frame.has_value());
+  EXPECT_EQ(buffer.accepted_frame_count(), 1U);
+  EXPECT_EQ(buffer.pending_frame_count(), 0U);
+
+  constexpr std::int64_t second_stamp_ns = 1200000000LL;
+  for (std::size_t camera_id = 0; camera_id < camera_count; ++camera_id) {
+    buffer.set_image(camera_id, make_image(second_stamp_ns));
+  }
+  EXPECT_EQ(buffer.take_ready_frame().status.reason, FrameAssemblyReason::MISSING_KINEMATIC_STATE);
+  buffer.set_kinematic_state(make_odometry(second_stamp_ns));
+  EXPECT_EQ(buffer.take_ready_frame().status.reason, FrameAssemblyReason::MISSING_ACCELERATION);
+  buffer.set_acceleration(make_acceleration(second_stamp_ns));
+  const auto second_frame = buffer.take_ready_frame();
+  ASSERT_TRUE(second_frame.frame.has_value());
+  EXPECT_EQ(second_frame.status.source_stamp_ns, second_stamp_ns);
+  EXPECT_EQ(buffer.accepted_frame_count(), 2U);
+  for (const auto & camera_info : second_frame.frame->camera_infos) {
+    EXPECT_NE(camera_info, nullptr);
+  }
+}
+
+TEST(FrameAssembly, RejectsCameraToleranceThatCannotBeRepresentedAsNanoseconds)
+{
+  constexpr double nanoseconds_per_millisecond = 1000000.0;
+  const auto rounded_limit =
+    static_cast<double>(std::numeric_limits<std::int64_t>::max()) / nanoseconds_per_millisecond;
+  const auto safe_limit = std::nextafter(rounded_limit, 0.0);
+
+  const FrontCriticalSynchronizationStrategy safe_strategy(0, 500.0, safe_limit);
+  EXPECT_LE(safe_strategy.camera_sync_tolerance_ns(), std::numeric_limits<std::int64_t>::max());
+  EXPECT_THROW(
+    FrontCriticalSynchronizationStrategy(0, 500.0, rounded_limit), std::invalid_argument);
+}
+
+TEST(FrameAssembly, RejectsAdjacentTickAndAcceptsMatchingCameraStamp)
+{
+  auto buffer = make_buffer();
+  set_camera_infos(buffer);
+  constexpr std::int64_t source_stamp_ns = 2000000000LL;
+  buffer.set_kinematic_state(make_odometry(source_stamp_ns));
+  buffer.set_acceleration(make_acceleration(source_stamp_ns));
+  for (std::size_t camera_id = 0; camera_id < camera_count; ++camera_id) {
+    const auto image_stamp_ns = camera_id == 4 ? source_stamp_ns - 200000000LL : source_stamp_ns;
+    buffer.set_image(camera_id, make_image(image_stamp_ns));
+  }
+
+  const auto mixed = buffer.take_ready_frame();
+  EXPECT_FALSE(mixed.frame.has_value());
+  EXPECT_EQ(mixed.status.reason, FrameAssemblyReason::IMAGE_STAMP_MISMATCH);
+  EXPECT_EQ(mixed.status.source_stamp_ns, source_stamp_ns);
+  EXPECT_EQ(mixed.status.missing_image_mask, 0U);
+  EXPECT_DOUBLE_EQ(mixed.status.image_stamp_span_ms, 200.0);
+  EXPECT_EQ(buffer.pending_frame_count(), 2U);
+
+  buffer.set_image(4, make_image(source_stamp_ns));
+  const auto repaired = buffer.take_ready_frame();
+  ASSERT_TRUE(repaired.frame.has_value());
+  for (const auto & image : repaired.frame->images) {
+    EXPECT_EQ(image->header.stamp, make_stamp(source_stamp_ns));
+  }
+  EXPECT_EQ(repaired.match_kind, FrameAssemblyResult::MatchKind::EXACT_TIMESTAMP);
+  EXPECT_EQ(buffer.accepted_frame_count(), 1U);
+  EXPECT_EQ(buffer.pending_frame_count(), 0U);
+  EXPECT_EQ(buffer.counters().superseded_frames, 1U);
+}
+
+TEST(FrameAssembly, SelectsLatestCausalVehicleStateDespiteOutOfOrderCallbacks)
+{
+  auto buffer = make_buffer();
+  set_camera_infos(buffer);
+  constexpr std::int64_t anchor_stamp_ns = 2500000000LL;
+  constexpr std::int64_t future_stamp_ns = anchor_stamp_ns + 50000000LL;
+  constexpr std::int64_t older_causal_stamp_ns = anchor_stamp_ns - 100000000LL;
+  constexpr std::int64_t latest_causal_stamp_ns = anchor_stamp_ns - 50000000LL;
