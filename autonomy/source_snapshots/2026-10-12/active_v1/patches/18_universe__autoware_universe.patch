+  std::vector<ObjectData> collision_candidates;
+  aeb_node_->createObjectDataUsingPredictedObjects(ego_path, ego_polygons, collision_candidates);
+  EXPECT_TRUE(collision_candidates.empty());
+
+  predicted_objects->objects.front().kinematics.initial_pose_with_covariance.pose.position.z = 0.5;
+  collision_candidates.clear();
+  aeb_node_->createObjectDataUsingPredictedObjects(ego_path, ego_polygons, collision_candidates);
+  EXPECT_FALSE(collision_candidates.empty());
+
+  predicted_objects->objects.front().kinematics.initial_pose_with_covariance.pose.position.z = 5.0;
+  predicted_objects->objects.front().shape.dimensions.z = std::numeric_limits<double>::quiet_NaN();
+  collision_candidates.clear();
+  aeb_node_->createObjectDataUsingPredictedObjects(ego_path, ego_polygons, collision_candidates);
+  EXPECT_FALSE(collision_candidates.empty());
