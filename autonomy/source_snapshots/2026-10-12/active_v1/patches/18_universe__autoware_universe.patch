--- /dev/null
+++ b/simulator/autoware_carla_interface/src/autoware_carla_interface/modules/runtime_timing.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+# HH_261012 - Provide rate-limited timing diagnostics without adding an unbounded event queue.
+
+# Copyright 2026 Tier IV, Inc.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+# http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Low-overhead, rate-limited timing diagnostics for the CARLA bridge."""
+
+import threading
+import time
+
+
+class RuntimeTimingMonitor:
+    """Report only slow runtime stages while keeping the normal path cheap."""
+
+    def __init__(
+        self,
+        logger,
+        threshold_sec=0.050,
+        log_interval_sec=5.0,
+        clock_ns=time.monotonic_ns,
+    ):
+        self._logger = logger
+        self._threshold_ns = int(threshold_sec * 1_000_000_000)
+        self._log_interval_ns = int(log_interval_sec * 1_000_000_000)
+        self._clock_ns = clock_ns
+        self._lock = threading.Lock()
+        self._last_log_ns = {}
+        self._suppressed = {}
+
+    def start(self):
+        """Return a monotonic start token for ``warn_if_slow``."""
+        return self._clock_ns()
+
+    @staticmethod
+    def _key(stage, fields):
+        # Rate-limit each camera/worker independently without letting volatile
+        # fields such as counters or source stamps create unbounded keys.
+        return (stage, fields.get("camera", ""), fields.get("worker", ""))
+
+    @staticmethod
+    def _format_fields(fields):
+        return " ".join(f"{name}={fields[name]}" for name in sorted(fields))
+
+    def _warn(self, message):
+        # Diagnostics must never mask a bridge or publisher exception.
+        try:
+            self._logger.warning(message)
+        except Exception:  # noqa: B902 - logging is deliberately fail-open
+            pass
+
+    def _claim_log_slot(self, key, now_ns):
+        with self._lock:
+            last_log_ns = self._last_log_ns.get(key)
+            if (
+                last_log_ns is not None
+                and now_ns - last_log_ns < self._log_interval_ns
+            ):
+                self._suppressed[key] = self._suppressed.get(key, 0) + 1
+                return None
+            suppressed = self._suppressed.pop(key, 0)
+            self._last_log_ns[key] = now_ns
+            return suppressed
+
+    def warn_if_slow(self, stage, started_ns, **fields):
+        """Warn when a monotonic duration is strictly greater than the threshold."""
+        finished_ns = self._clock_ns()
+        duration_ns = max(0, finished_ns - started_ns)
+        if duration_ns <= self._threshold_ns:
+            return duration_ns
+
+        key = self._key(stage, fields)
+        suppressed = self._claim_log_slot(key, finished_ns)
+        if suppressed is None:
+            return duration_ns
+
+        details = {
+            "duration_ms": f"{duration_ns / 1_000_000.0:.3f}",
+            "monotonic_ns": finished_ns,
+            **fields,
+        }
+        if suppressed:
+            details["suppressed"] = suppressed
+        self._warn(f"runtime_timing stage={stage} {self._format_fields(details)}")
+        return duration_ns
+
+    def warn_event(self, stage, **fields):
+        """Rate-limit a structured warning for an exceptional non-timing event."""
+        now_ns = self._clock_ns()
+        key = self._key(stage, fields)
+        suppressed = self._claim_log_slot(key, now_ns)
+        if suppressed is None:
+            return False
+
+        details = {"monotonic_ns": now_ns, **fields}
+        if suppressed:
+            details["suppressed"] = suppressed
+        self._warn(f"runtime_event stage={stage} {self._format_fields(details)}")
+        return True
