+constexpr double kMinimumQuaternionNorm = std::numeric_limits<double>::epsilon();
+constexpr double kYawOnlyQuaternionTolerance = 1.0e-6;
+
+struct NormalizedQuaternion
+{
+  double x;
+  double y;
+  double z;
+  double w;
+};
+
+std::optional<NormalizedQuaternion> normalizeQuaternion(
+  const geometry_msgs::msg::Quaternion & orientation)
+{
+  const double components[] = {orientation.x, orientation.y, orientation.z, orientation.w};
+  double scale = 0.0;
+  for (const double component : components) {
+    if (!std::isfinite(component)) {
+      return std::nullopt;
+    }
+    scale = std::max(scale, std::abs(component));
+  }
+  if (scale == 0.0) {
+    return std::nullopt;
+  }
+
+  double scaled_squared_norm = 0.0;
+  for (const double component : components) {
+    const double scaled_component = component / scale;
+    scaled_squared_norm += scaled_component * scaled_component;
+  }
+  const double scaled_norm = std::sqrt(scaled_squared_norm);
+  if (
+    !std::isfinite(scaled_norm) || scaled_norm == 0.0 ||
+    scale <= kMinimumQuaternionNorm / scaled_norm) {
+    return std::nullopt;
+  }
+
+  return NormalizedQuaternion{
+    (orientation.x / scale) / scaled_norm, (orientation.y / scale) / scaled_norm,
+    (orientation.z / scale) / scaled_norm, (orientation.w / scale) / scaled_norm};
+}
+
+bool isYawOnly(const NormalizedQuaternion & orientation)
+{
+  return std::hypot(orientation.x, orientation.y) <= kYawOnlyQuaternionTolerance;
+}
+
+std::optional<double> getBoundingBoxVerticalHalfExtent(
+  const autoware_perception_msgs::msg::Shape & shape, const NormalizedQuaternion & orientation)
+{
+  const double dimensions[] = {shape.dimensions.x, shape.dimensions.y, shape.dimensions.z};
+  if (std::any_of(dimensions, dimensions + 3, [](const double dimension) {
+        return !std::isfinite(dimension) || dimension <= 0.0;
+      })) {
+    return std::nullopt;
+  }
+
+  // Third row of the rotation matrix that maps the object's local bounding box into the frame in
+  // which the vertical limits are expressed. Its absolute dot product with the three half extents
+  // is the exact vertical support of an arbitrarily oriented box.
+  const double rotation_z_x = 2.0 * (orientation.x * orientation.z - orientation.w * orientation.y);
+  const double rotation_z_y = 2.0 * (orientation.y * orientation.z + orientation.w * orientation.x);
+  const double rotation_z_z =
+    1.0 - 2.0 * (orientation.x * orientation.x + orientation.y * orientation.y);
+  const double half_extent = 0.5 * (std::abs(rotation_z_x) * shape.dimensions.x +
+                                    std::abs(rotation_z_y) * shape.dimensions.y +
+                                    std::abs(rotation_z_z) * shape.dimensions.z);
+  return std::isfinite(half_extent) ? std::make_optional(half_extent) : std::nullopt;
+}
