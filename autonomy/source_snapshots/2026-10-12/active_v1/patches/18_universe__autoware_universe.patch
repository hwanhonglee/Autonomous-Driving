+  const auto newest_stamp_ns = base_stamp_ns + 4 * period_ns;
+  for (std::size_t camera_id = 1; camera_id < camera_count; ++camera_id) {
+    buffer.set_image(camera_id, make_image(newest_stamp_ns));
+  }
+  buffer.set_kinematic_state(make_odometry(newest_stamp_ns));
+  buffer.set_acceleration(make_acceleration(newest_stamp_ns));
+  const auto newest = buffer.take_ready_frame();
+  ASSERT_TRUE(newest.frame.has_value());
+  EXPECT_EQ(newest.status.source_stamp_ns, newest_stamp_ns);
+  EXPECT_EQ(buffer.pending_frame_count(), 0U);
+  EXPECT_EQ(buffer.counters().capacity_pruned_frames, 2U);
+  EXPECT_EQ(buffer.counters().superseded_frames, 2U);
+}
+
+}  // namespace autoware::tensorrt_vad
