@@ -0,0 +1,55 @@
+# Copyright 2026 Autoware Foundation
+# HH_261012 - Convert wheel steering to the virtual tire angle and retain signed speed in the declared base_link frame.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+# http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import math
+
+
+def fl_wheel_to_virtual_tire_angle(fl_angle_rad, wheel_base_m, wheel_tread_m):
+    """Convert the front-left wheel angle to the virtual bicycle tire angle."""
+    if not math.isfinite(wheel_base_m) or wheel_base_m <= 0.0:
+        raise ValueError("wheel_base must be positive and finite")
+    if not math.isfinite(wheel_tread_m) or wheel_tread_m < 0.0:
+        raise ValueError("wheel_tread must be non-negative and finite")
+    if not math.isfinite(fl_angle_rad) or abs(fl_angle_rad) >= math.pi / 2.0:
+        raise ValueError("front-left wheel angle must be finite and within (-pi/2, pi/2)")
+
+    tangent = math.tan(fl_angle_rad)
+    denominator = wheel_base_m + 0.5 * wheel_tread_m * tangent
+    if denominator <= 0.0:
+        raise ValueError("wheel geometry produces an invalid virtual steering radius")
+    return math.atan(wheel_base_m * tangent / denominator)
+
+
+def carla_yaw_rate_to_ros(angular_velocity_z_deg_per_sec):
+    """Convert CARLA clockwise-positive deg/s to ROS counter-clockwise rad/s."""
+    if not math.isfinite(angular_velocity_z_deg_per_sec):
+        raise ValueError("CARLA yaw rate must be finite")
+    return -math.radians(angular_velocity_z_deg_per_sec)
+
+
+def rear_axle_lateral_velocity(
+    center_lateral_velocity_mps, heading_rate_rad_per_sec, center_to_rear_axle_m
+):
+    """Translate planar lateral velocity from the vehicle center to the rear axle."""
+    values = (
+        center_lateral_velocity_mps,
+        heading_rate_rad_per_sec,
+        center_to_rear_axle_m,
+    )
+    if not all(math.isfinite(value) for value in values):
+        raise ValueError("rear-axle velocity inputs must be finite")
+    if center_to_rear_axle_m < 0.0:
+        raise ValueError("center-to-rear-axle distance must be non-negative")
+    return center_lateral_velocity_mps - center_to_rear_axle_m * heading_rate_rad_per_sec
