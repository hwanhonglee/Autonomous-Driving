+bool has_finite_lanelet_geometry(const lanelet::ConstLaneletOrAreas & path)
+{
+  if (path.empty()) {
+    return false;
+  }
+  return std::all_of(path.begin(), path.end(), [](const auto & element) {
+    if (!element.isLanelet()) {
+      return true;
+    }
+    const auto & centerline = static_cast<const lanelet::ConstLanelet &>(element).centerline();
+    return centerline.size() >= 2 &&
+           std::all_of(centerline.begin(), centerline.end(), [](const auto & point) {
+             return std::isfinite(point.x()) && std::isfinite(point.y()) &&
+                    std::isfinite(point.z());
+           });
+  });
+}
