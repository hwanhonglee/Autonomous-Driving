+TEST(VadRuntimeStartup, InitializesModelBeforeSubscribersAndStartsWorkerLast)
+{
+  bool model_ready = false;
+  bool subscribers_ready = false;
+  bool worker_started = false;
+  std::vector<std::string> order;
+
+  VadRuntimeStartup::run(
+    [&]() {
+      EXPECT_FALSE(subscribers_ready);
+      EXPECT_FALSE(worker_started);
+      model_ready = true;
+      order.emplace_back("model");
+    },
+    [&]() {
+      EXPECT_TRUE(model_ready);
+      EXPECT_FALSE(worker_started);
+      subscribers_ready = true;
+      order.emplace_back("subscribers");
+    },
+    [&]() {
+      EXPECT_TRUE(model_ready);
+      EXPECT_TRUE(subscribers_ready);
+      worker_started = true;
+      order.emplace_back("worker");
+    });
+
+  EXPECT_EQ(order, (std::vector<std::string>{"model", "subscribers", "worker"}));
