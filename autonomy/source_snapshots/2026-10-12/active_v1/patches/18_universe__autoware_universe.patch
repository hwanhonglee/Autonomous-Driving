+VadInputTopicData SynchronizedFrameBuffer::materialize_approximate_frame(
+  const std::int64_t anchor_stamp_ns) const
+{
+  VadInputTopicData frame(num_cameras_);
+  for (std::size_t camera_id = 0; camera_id < static_cast<std::size_t>(num_cameras_); ++camera_id) {
+    frame.images[camera_id] = find_nearest_image(camera_id, anchor_stamp_ns);
+  }
+  frame.camera_infos = camera_infos_;
+  frame.kinematic_state = find_latest_causal_kinematic_state(anchor_stamp_ns);
+  frame.acceleration = find_latest_causal_acceleration(anchor_stamp_ns);
+  const auto & anchor_image = frame.images[anchor_camera_id_];
+  if (anchor_image) {
+    frame.stamp = rclcpp::Time(anchor_image->header.stamp);
+  }
+  return frame;
