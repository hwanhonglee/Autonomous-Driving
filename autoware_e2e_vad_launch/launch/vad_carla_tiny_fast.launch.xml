<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Project-owned deployment overlay for the fixed carla_tiny v0.1 model. -->
  <arg name="log_level" default="info"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="data_path" default="$(env HOME)/autoware_data/ml_models"/>
  <arg name="model_path" default="$(var data_path)/vad"/>
  <arg name="plugins_path" default="$(find-pkg-share autoware_tensorrt_plugins)"/>
  <arg
    name="use_fp16_heads"
    default="false"
    description="Experimental temporal-head FP16 engines; requires route/object parity testing"
  />
  <arg
    name="model_override_file"
    default="$(find-pkg-share autoware_e2e_vad_launch)/config/vad_carla_tiny_fast.param.yaml"
    description="Last deployment parameter overlay; keep the ONNX input/output contract unchanged"
  />
  <arg
    name="bev_shift_mode"
    default="legacy"
    description="Temporal BEV translation A/B mode: legacy, ros_corrected, or zero"
  />

  <!-- Camera order is fixed by training. -->
  <arg name="camera_info0" default="/sensing/camera/CAM_FRONT/camera_info"/>
  <arg name="camera_info1" default="/sensing/camera/CAM_BACK/camera_info"/>
  <arg name="camera_info2" default="/sensing/camera/CAM_FRONT_LEFT/camera_info"/>
  <arg name="camera_info3" default="/sensing/camera/CAM_BACK_LEFT/camera_info"/>
  <arg name="camera_info4" default="/sensing/camera/CAM_FRONT_RIGHT/camera_info"/>
  <arg name="camera_info5" default="/sensing/camera/CAM_BACK_RIGHT/camera_info"/>
  <arg name="image0" default="/sensing/camera/CAM_FRONT/image_raw"/>
  <arg name="image1" default="/sensing/camera/CAM_BACK/image_raw"/>
  <arg name="image2" default="/sensing/camera/CAM_FRONT_LEFT/image_raw"/>
  <arg name="image3" default="/sensing/camera/CAM_BACK_LEFT/image_raw"/>
  <arg name="image4" default="/sensing/camera/CAM_FRONT_RIGHT/image_raw"/>
  <arg name="image5" default="/sensing/camera/CAM_BACK_RIGHT/image_raw"/>
  <arg name="kinematic_state" default="/localization/kinematic_state"/>
  <arg name="acceleration" default="/localization/acceleration"/>

  <arg name="output_objects" default="/perception/object_recognition/objects"/>
  <arg name="output_trajectory" default="/planning/trajectory"/>
  <arg
    name="output_candidate_trajectories"
    default="/planning/vad/candidate_trajectories"
  />
  <arg name="output_map_points" default="/perception/vad/map_points"/>

  <let
    name="fast_config"
    value="$(find-pkg-share autoware_e2e_vad_launch)/config/vad_carla_tiny_fast.param.yaml"
    unless="$(var use_fp16_heads)"
  />
  <let
    name="fast_config"
    value="$(find-pkg-share autoware_e2e_vad_launch)/config/vad_carla_tiny_fast_fp16_heads.param.yaml"
    if="$(var use_fp16_heads)"
  />

  <node
    pkg="autoware_tensorrt_vad"
    exec="vad_node"
    name="vad_carla_tiny"
    output="screen"
    args="--ros-args --log-level $(var log_level)"
  >
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <!-- Load the official contract first, then override only deployment settings. -->
    <param
      from="$(find-pkg-share autoware_tensorrt_vad)/config/vad_carla_tiny.param.yaml"
      allow_substs="true"
    />
    <param from="$(var fast_config)" allow_substs="true"/>
    <param from="$(var model_override_file)" allow_substs="true"/>
    <param name="interface_params.bev_shift_mode" value="$(var bev_shift_mode)"/>
    <param
      from="$(find-pkg-share autoware_tensorrt_vad)/config/object_class_remapper_carla_tiny.param.yaml"
      allow_substs="true"
    />

    <remap from="~/output/objects" to="$(var output_objects)"/>
    <remap from="~/output/trajectory" to="$(var output_trajectory)"/>
    <remap from="~/output/trajectories" to="$(var output_candidate_trajectories)"/>
    <remap from="~/output/map" to="$(var output_map_points)"/>

    <remap from="~/input/camera_info0" to="$(var camera_info0)"/>
    <remap from="~/input/camera_info1" to="$(var camera_info1)"/>
    <remap from="~/input/camera_info2" to="$(var camera_info2)"/>
    <remap from="~/input/camera_info3" to="$(var camera_info3)"/>
    <remap from="~/input/camera_info4" to="$(var camera_info4)"/>
    <remap from="~/input/camera_info5" to="$(var camera_info5)"/>
    <remap from="~/input/image0" to="$(var image0)"/>
    <remap from="~/input/image1" to="$(var image1)"/>
    <remap from="~/input/image2" to="$(var image2)"/>
    <remap from="~/input/image3" to="$(var image3)"/>
    <remap from="~/input/image4" to="$(var image4)"/>
    <remap from="~/input/image5" to="$(var image5)"/>
    <remap from="~/input/kinematic_state" to="$(var kinematic_state)"/>
    <remap from="~/input/acceleration" to="$(var acceleration)"/>
  </node>
</launch>
