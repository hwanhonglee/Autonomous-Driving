<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="vehicle_model" default="sample_vehicle"/>
  <arg name="respawn" default="true"/>
  <arg
    name="rviz_config"
    default="$(find-pkg-share autoware_e2e_vad_launch)/rviz/autoware_vad_carla.rviz"
    description="RViz profile combining the standard Autoware layout with CARLA VAD outputs"
  />

  <node
    pkg="rviz2"
    exec="rviz2"
    name="autoware_vad_rviz"
    args="-d $(var rviz_config) -s $(find-pkg-share autoware_launch)/rviz/image/autoware.png"
    output="screen"
    respawn="$(var respawn)"
  >
    <env name="QT_QPA_PLATFORMTHEME" value="qt5ct"/>
    <param
      from="$(find-pkg-share $(var vehicle_model)_description)/config/vehicle_info.param.yaml"
    />
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
