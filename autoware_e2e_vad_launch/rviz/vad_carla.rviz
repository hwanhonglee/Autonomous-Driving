Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Route Guidance1
        - /E2E VAD1
        - /E2E VAD1/VAD Selected Trajectory1
        - /E2E VAD1/VAD Candidate Trajectories1
        - /E2E VAD1/VAD Predicted Objects1
      Splitter Ratio: 0.56
    Tree Height: 980
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 110; 118; 126
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Ground Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Class: rviz_default_plugins/RobotModel
          Collision Enabled: false
          Description File: ""
          Description Source: Topic
          Description Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /robot_description
          Enabled: true
          Name: Ego Vehicle
          Update Interval: 0
          Value: true
          Visual Enabled: true
        - Class: rviz_default_plugins/Axes
          Enabled: true
          Length: 2
          Name: Ego Axes
          Radius: 0.12
          Reference Frame: base_link
          Value: true
        - Class: rviz_default_plugins/TF
          Enabled: false
          Frame Timeout: 15
          Frames:
            All Enabled: true
          Marker Scale: 0.5
          Name: Sensor TF
          Show Arrows: true
          Show Axes: true
          Show Names: false
          Tree: {}
          Update Interval: 0
          Value: false
        - Class: rviz_default_plugins/Odometry
          Angle Tolerance: 0.1
          Enabled: true
          Keep: 1
          Name: Vehicle Motion
          Position Tolerance: 0.1
          Shape:
            Alpha: 0.45
            Axes Length: 0.6
            Axes Radius: 0.08
            Color: 80; 200; 255
            Head Length: 0.2
            Head Radius: 0.1
            Shaft Length: 0.8
            Shaft Radius: 0.05
            Value: Arrow
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /localization/kinematic_state
          Value: true
      Enabled: true
      Name: Vehicle
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.9
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 60; 220; 120
          Enabled: true
          Line Style: Lines
          Line Width: 0.18
          Name: CARLA Global Route
          Pose Style: None
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /planning/vad_route/reference_path
          Value: true
        - Alpha: 0.95
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 50; 150; 255
          Enabled: true
          Line Style: Lines
          Line Width: 0.12
          Name: Actual Ego Path
          Pose Style: None
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /planning/vad_route/actual_path
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Marker Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /planning/vad_route/markers
          Name: Goal And Command
          Namespaces: {}
          Queue Size: 10
          Value: true
      Enabled: true
      Name: Route Guidance
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_plugins/Trajectory
          Color Border Vel Max: 15
          Enabled: true
          Name: Route-corrected Trajectory
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /planning/trajectory
          Value: true
          View Footprint:
            Alpha: 0.5
            Color: 255; 210; 40
            Offset from BaseLink: 0
            Rear Overhang: 1.03
            Value: false
            Vehicle Length: 4.77
            Vehicle Width: 1.83
          View Path:
            Alpha: 1
            Color: 255; 220; 45
            Constant Color: true
            Constant Width: true
            Value: true
            Width: 0.32
          View Point:
            Alpha: 1
            Color: 255; 255; 255
            Offset: 0.08
            Radius: 0.12
            Value: true
          View Text Slope:
            Scale: 0.3
            Value: false
          View Text Velocity:
            Scale: 0.3
            Value: false
        - Class: rviz_plugins/Trajectory
          Color Border Vel Max: 15
          Enabled: true
          Name: Selected Raw VAD Trajectory
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /planning/vad_route/selected_raw_trajectory
          Value: true
          View Footprint:
            Alpha: 0.35
            Color: 220; 70; 190
            Offset from BaseLink: 0
            Rear Overhang: 1.03
            Value: false
            Vehicle Length: 4.77
            Vehicle Width: 1.83
          View Path:
            Alpha: 0.85
            Color: 220; 70; 190
            Constant Color: true
            Constant Width: true
            Value: true
            Width: 0.15
          View Point:
            Alpha: 0.8
            Color: 255; 180; 235
            Offset: 0.08
            Radius: 0.08
            Value: true
          View Text Slope:
            Scale: 0.3
            Value: false
          View Text Velocity:
            Scale: 0.3
            Value: false
        - Class: rviz_plugins/CandidateTrajectories
          Enabled: true
          Name: VAD Candidate Trajectories
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /planning/vad/candidate_trajectories
          Value: true
          View Generator Names:
            Generator Text Scale: 0.4
            Value: false
          View Path:
            Alpha: 0.22
            Coloring Mode: Index Based
            Constant Width: true
            Fade Out Distance [m]: 0
            Value: true
            Width: 0.04
          View Velocity:
            Alpha: 0.5
            Constant Color: false
            Scale: 0.2
            Value: false
        - Alpha: 0.8
          Class: autoware_perception_rviz_plugin/PredictedObjects
          Color: 255; 255; 255
          Covariance:
            Confidence Interval: 95%
            Pose: false
            Twist: false
            Yaw: false
            Yaw Rate: false
          Enabled: true
          Line Width: 0.12
          Name: VAD Predicted Objects
          Namespaces: {}
          Path:
            Path Confidence: false
            Path Footprint: false
            Path Resolution: Normal
            Predicted Path: true
          Per Class Color:
            ANIMAL: 255; 105; 180
            BUS: 30; 144; 255
            CAR: 30; 144; 255
            CYCLIST: 255; 128; 0
            HAZARD: 255; 69; 0
            MOTORCYCLE: 255; 128; 0
            PEDESTRIAN: 255; 80; 120
            TRAILER: 30; 144; 255
            TRUCK: 30; 144; 255
            UNKNOWN: 255; 255; 255
            Value: true
          Shape:
            BBox Footprint: true
            Mesh:
              Signal Lights: false
              Value: false
            Shape Type: Fill
          Text:
            Acceleration: false
            Existence Probability: false
            Label: true
            Position: false
            UUID: false
            Velocity: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /perception/object_recognition/objects
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Marker Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /perception/vad/map_points
          Name: VAD BEV Map Points
          Namespaces:
            {}
          Queue Size: 10
          Value: true
      Enabled: true
      Name: E2E VAD
  Enabled: true
  Global Options:
    Background Color: 28; 32; 36
    Fixed Frame: map
    Frame Rate: 30
  Name: Autoware E2E VAD
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 255; 220; 45
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Follow Ego
      Near Clip Distance: 0.01
      Scale: 10
      Target Frame: base_link
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved:
      - Angle: 0
        Class: rviz_default_plugins/TopDownOrtho
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Invert Z Axis: false
        Name: Follow Ego
        Near Clip Distance: 0.01
        Scale: 10
        Target Frame: base_link
        Value: TopDownOrtho (rviz_default_plugins)
        X: 0
        Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 2080
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: false
  Width: 3800
  X: 20
  Y: 40
