  "continuation_policy": {
    "one_attempt_per_case": true,
    "automatic_retry": false,
    "stop_on": [
      "ownership or setup failure",
      "source/input pin mismatch",
      "collector or cleanup failure",
      "control-receipt/ACK protocol mismatch",
      "observed collision or lane event",
      "existing speed/projection/goal-stop operational guard failure"
    ],
    "do_not_abort_only_for": "Raw future-label geometry gate failure is an expected diagnostic outcome; retain and report it, then continue the prospectively declared matched cases if operational and protocol checks pass.",
    "no_extra_case_or_retuning": true
  },
  "operational_scope": {
    "local_owned_carla_only": true,
    "port_range": [
      2100,
      2101,
      2102
    ],
    "foreign_process_signals": false,
    "remote_commands": false,
    "test_payload_reads": false,
    "no_installs": true,
    "setup_exclusion": "Existing vehicles and sensors plus walkers and walker controllers must be absent; only owned spawned actors are controlled.",
    "event_abort": "v6-only governor failure at the next snapshot containing collision/lane events; asynchronous delivery is not a zero-latency guarantee."
  },
  "comparison_criteria": {
    "primary": "Report full-window failure counts AND rates with each case's actual full-anchor denominator; no cropping, re-timing, filtering or relabeling.",
    "favorable_signal": "Both zero-arm repeats must improve curvature failure count AND rate versus both native repeats, with no other raw-label gate, control protocol, goal-stop, camera, collision/lane or safety regression. Otherwise mixed/no improvement; never choose only the favorable repeat.",
    "secondary": [
      "separate launch/coast/brake failing unique ticks and duplicated future-step incidences",
      "all treatment eligibility transitions and unchanged nonsteer control fields",
      "same-arm repeat and AB pretreatment physical-state comparisons"
    ],
    "training_admission": "Never automatic. Research-only even after favorable signal; independent dataset QA and split review required."
  }
