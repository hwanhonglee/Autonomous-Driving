oving=True;self.low_since=None;self.stationary_reported=False         self.base_rxe=self.read_stat('rx_errors');self.base_txe=self.read_stat('tx_errors');self.base_drop=self.read_stat('rx_dropped')         self.base_rx=self.read_stat('rx_packets');self.base_tx=self.read_stat('tx_packets');self.base_busoff=0         self.health_values=(0,0,0,0,0,0);self.running=True         self.create_timer(0.1,self.tick)         print('PERSISTENT_MONITOR_START',time.strftime('%Y-%m-%dT%H:%M:%S%z'),flush=True)     def read_stat(self,n):return int(open('/sys/class/net/can0/statistics/'+n).read())     def transition(self,key,bad,msg):         old=self.unsafe.get(key,False)         if bad and not old:print('!!! ALERT',time.strftime('%Y-%m-%dT%H:%M:%S%z'),msg,flush=True)         elif old and not bad:print('RECOVERED',time.strftime('%Y-%m-%dT%H:%M:%S%z'),key,flush=True)         self.unsafe[key]=bad     def to_cb(self,m):         if m.id==0x630 and len(m.data)>3:             self.ros_frames+=1;self.ros_req=int(m.data[3]);self.last_ros630=time.monotonic()             self.transition('ros_request',self.ros_req!=0,f'ROS 0x630 request data[3]={self.ros_req} data={list(m.data)}')     def cruise_cb(self,m):         self.cruise=bool(m.data);self.last_cruise=time.monotonic()         self.transition('cruise',self.cruise,'Cruise became TRUE')     def control_cb(self,m):         self.control=int(m.mode);self.last_control=time.monotonic()         self.transition('vehicle_control',self.control in (1,2,3),f'vehicle control autonomous-like mode={self.control}')     def op_cb(self,m):         self.op_mode=int(m.mode);self.enabled=bool(m.is_autoware_control_enabled)         self.transition('autoware_control',self.op_mode==2 or self.enabled,f'operation mode={self.op_mode} Autoware control enabled={self.enabled}')     def speed_cb(self,m):         self.speed=float(m.longitudinal_velocity);self.last_speed=time.monotonic();now=self.last_speed         if abs(self.speed)>=0.01:             self.seen_moving=True;self.low_since=None;self.stationary_reported=False         elif self.seen_moving:             if self.low_since is None:self.low_since=now             if not self.stationary_reported and now-self.low_since>=5:                 self.stationary_reported=True                 print('*** STATIONARY_GATE',time.strftime('%Y-%m-%dT%H:%M:%S%z'),f'longitudinal={self.speed:.6f} low_for={now-self.low_since:.1f}s',flush=True)     def read_physical(self):         while True:             try:raw=self.cs.recv(16)             except BlockingIOError:return             if len(raw)<16:continue             cid,dlc,data=struct.unpack('=IB3x8s',raw);cid&=0x1fffffff             if cid==0x630 and dlc>3:                 self.phy_frames+=1;self.phy_req=int(data[3]);self.last_phy630=time.monotonic()                 self.transition('physical_request',self.phy_req!=0,f'physical 0x630 request data[3]={self.phy_req} data={list(data[:dlc])}')     def health(self,now):         for pid,name in EXPECTED.items():             self.transition('process_'+str(pid),not os.path.exists(f'/proc/{pid}/stat'),f'expected process died pid={pid} role={name}')         rxe=self.read_stat('rx_errors');txe=self.read_stat('tx_errors');drop=self.read_stat('rx_dropped')         rx=self.read_stat('rx_packets');tx=self.read_stat('tx_packets')         try:             p=subprocess.run(['ip','-details','-statistics','link','show','can0'],capture_output=True,text=True,timeout=1)             s=p.stdout         except Exception as e:             s='';self.transition('can_query',True,f'CAN state query failed: {e}')         else:self.transition('can_query',False,'')         self.transition('can_state','can state ERROR-ACTIVE' not in s,'can0 is not ERROR-ACTIVE / possible bus-off')         self.transition('can_errors',rxe>self.base_rxe or txe>self.base_txe,f'CAN errors increased rx={rxe-self.base_rxe} tx={txe-self.base_txe}')         m=re.search(r're-started bus-errors arbit-lost error-warn error-pass bus-off\s*\n\s*(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)',s)         busoff=int(m.group(6)) if m else 0         self.transition('bus_off',busoff>self.base_busoff,f'CAN bus-off counter increased to {busoff}')         for key,last,label in (             ('ros630_stale',self.last_ros630,'ROS 0x630'),('physical630_stale',self.last_phy630,'physical 0x630'),             ('speed_stale',self.last_speed,'vehicle speed'),('cruise_stale',self.last_cruise,'Cruise status'),             ('control_stale',self.last_control,'vehicle control mode')):             stale=now-self.start>5 and (last is None or now-last>2)             self.transition(key,stale,f'{label} stale >2s')         self.health_values=(rxe-self.base_rxe,txe-self.base_txe,drop-self.base_drop,busoff,rx-self.base_rx,tx-self.base_tx)     def tick(self):         now=time.monotonic();self.read_physical()         if now-self.last_health>=2:self.health(now);self.last_health=now         if now-self.last_heartbeat>=120:             elapsed=now-self.last_heartbeat             ages=lambda x:None if x is None else round(now-x,2)             hv=self.health_values             print('HEARTBEAT',time.strftime('%Y-%m-%dT%H:%M:%S%z'),                   f'speed={self.speed}',f'stationary={self.stationary_reported}',                   f'cruise={self.cruise}',f'ros_req={self.ros_req}',f'phy_req={self.phy_req}',                   f'veh_control={self.control}',f'op_mode={self.op_mode}',f'enabled={self.enabled}',                   f'ros630_hz={self.ros_frames/elapsed:.2f}',f'phy630_hz={self.phy_frames/elapsed:.2f}',                   f'ages_ros_phy_speed={ages(self.last_ros630)}/{ages(self.last_phy630)}/{ages(self.last_speed)}',                   f'can_deltas_rxerr_txerr_drop_busoff_rxpkt_txpkt={hv}',                   f'unsafe_active={[k for k,v in self.unsafe.items() if v]}',flush=True)             self.ros_frames=0;self.phy_frames=0;self.last_heartbeat=now  rclpy.init();n=PersistentAudit() try:     while rclpy.ok():rclpy.spin_once(n,timeout_sec=0.1) except KeyboardInterrupt:     pass finally:     print('PERSISTENT_MONITOR_END',time.strftime('%Y-%m-%dT%H:%M:%S%z'),flush=True)     n.cs.close();n.destroy_node()     if rclpy.ok():rclpy.shutdown()  PY
