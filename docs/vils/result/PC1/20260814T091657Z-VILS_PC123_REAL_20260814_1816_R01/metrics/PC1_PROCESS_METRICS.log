;self.low_since=None;self.stationary_reported=False         elif self.seen_moving:             if self.low_since is None:self.low_since=now             if not self.stationary_reported and now-self.low_since>=5:                 self.stationary_reported=True                 print('*** STATIONARY_GATE',time.strftime('%Y-%m-%dT%H:%M:%S%z'),f'longitudinal={self.speed:.6f} low_for={now-self.low_since:.1f}s',flush=True)     def read_physical(self):         while True:             try:raw=self.cs.recv(16)             except BlockingIOError:return             if len(raw)<16:continue             cid,dlc,data=struct.unpack('=IB3x8s',raw);cid&=0x1fffffff             if cid==0x630 and dlc>3:                 self.phy_frames+=1;self.phy_req=int(data[3]);self.last_phy630=time.monotonic()                 self.transition('physical_request',self.phy_req!=0,f'physical 0x630 request data[3]={self.phy_req} data={list(data[:dlc])}')     def health(self,now):         for pid,name in EXPECTED.items():             self.transition('process_'+str(pid),not os.path.exists(f'/proc/{pid}/stat'),f'expected process died pid={pid} role={name}')         rxe=self.read_stat('rx_errors');txe=self.read_stat('tx_errors');drop=self.read_stat('rx_dropped')         rx=self.read_stat('rx_packets');tx=self.read_stat('tx_packets')         try:             p=subprocess.run(['ip','-details','-statistics','link','show','can0'],capture_output=True,text=True,timeout=1)             s=p.stdout         except Exception as e:             s='';self.transition('can_query',True,f'CAN state query failed: {e}')         else:self.transition('can_query',False,'')         self.transition('can_state','can state ERROR-ACTIVE' not in s,'can0 is not ERROR-ACTIVE / possible bus-off')         self.transition('can_errors',rxe>self.base_rxe or txe>self.base_txe,f'CAN errors increased rx={rxe-self.base_rxe} tx={txe-self.base_txe}')         m=re.search(r're-started bus-errors arbit-lost error-warn error-pass bus-off\s*\n\s*(\d+)\s+(\d+)\s