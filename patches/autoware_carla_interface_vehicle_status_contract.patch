+
+import math
+
+
+def fl_wheel_to_virtual_tire_angle(fl_angle_rad, wheel_base_m, wheel_tread_m):
+    """Convert the front-left wheel angle to the virtual bicycle tire angle."""
+    if not math.isfinite(wheel_base_m) or wheel_base_m <= 0.0:
+        raise ValueError("wheel_base must be positive and finite")
+    if not math.isfinite(wheel_tread_m) or wheel_tread_m < 0.0:
+        raise ValueError("wheel_tread must be non-negative and finite")
+    if not math.isfinite(fl_angle_rad) or abs(fl_angle_rad) >= math.pi / 2.0:
+        raise ValueError("front-left wheel angle must be finite and within (-pi/2, pi/2)")
+
+    tangent = math.tan(fl_angle_rad)
+    denominator = wheel_base_m + 0.5 * wheel_tread_m * tangent
+    if denominator <= 0.0:
+        raise ValueError("wheel geometry produces an invalid virtual steering radius")
+    return math.atan(wheel_base_m * tangent / denominator)
+
+
+def carla_yaw_rate_to_ros(angular_velocity_z_deg_per_sec):
+    """Convert CARLA clockwise-positive deg/s to ROS counter-clockwise rad/s."""
+    if not math.isfinite(angular_velocity_z_deg_per_sec):
+        raise ValueError("CARLA yaw rate must be finite")
+    return -math.radians(angular_velocity_z_deg_per_sec)
