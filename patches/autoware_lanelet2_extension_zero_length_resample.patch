+TEST(Utilities, Town05DuplicateBoundaryCenterlineIsFinite)  // NOLINT for gtest
+{
+  constexpr lanelet::Id town05_turn_lanelet_id = 28467;
+  const Point3d left_start(getId(), -49.6552200317, 74.6567993164, 0.0554504394531);
+  const Point3d left_start_duplicate(getId(), -49.6552200317, 74.6567993164, 0.0554504394531);
+  const Point3d left_middle(getId(), -49.6611099243, 75.6567840576, 0.0554504394531);
+  const Point3d left_end(getId(), -65.7798919678, 89.7428817749, 0.0);
+  const Point3d right_start(getId(), -46.1504745483, 73.8610992432, 0.0554504394531);
+  const Point3d right_middle(getId(), -46.1552810669, 74.6774139404, 0.0554504394531);
+  const Point3d right_end(getId(), -65.7746200562, 93.2428741455, 0.0);
+
+  const LineString3d left_bound(getId(), {left_start, left_start_duplicate, left_middle, left_end});
+  const LineString3d right_bound(getId(), {right_start, right_middle, right_end});
+  Lanelet turn_lanelet(town05_turn_lanelet_id, left_bound, right_bound);
+  turn_lanelet.attributes()[lanelet::AttributeName::Subtype] = lanelet::AttributeValueString::Road;
+
+  auto map = std::make_shared<lanelet::LaneletMap>();
+  map->add(turn_lanelet);
+  lanelet::utils::overwriteLaneletsCenterline(map, 1.0, true);
+
+  const auto centerline = map->laneletLayer.get(town05_turn_lanelet_id).centerline();
+  ASSERT_GT(centerline.size(), 2U);
+  EXPECT_TRUE(std::isfinite(lanelet::geometry::length(centerline)));
+  EXPECT_GT(lanelet::geometry::length(centerline), 0.0);
+  for (const auto & point : centerline) {
+    EXPECT_TRUE(std::isfinite(point.x()));
+    EXPECT_TRUE(std::isfinite(point.y()));
+    EXPECT_TRUE(std::isfinite(point.z()));
+  }
+
+  EXPECT_NEAR(centerline.front().x(), (left_start.x() + right_start.x()) / 2.0, 1.0e-9);
+  EXPECT_NEAR(centerline.front().y(), (left_start.y() + right_start.y()) / 2.0, 1.0e-9);
+  EXPECT_NEAR(centerline.back().x(), (left_end.x() + right_end.x()) / 2.0, 1.0e-9);
+  EXPECT_NEAR(centerline.back().y(), (left_end.y() + right_end.y()) / 2.0, 1.0e-9);
+}
