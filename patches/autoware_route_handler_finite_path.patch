+TEST_F(TestRouteHandler, emptyPathFailsClosed)
+{
+  const lanelet::ConstLanelets empty_path;
+  EXPECT_TRUE(route_handler_->createMapSegments(empty_path).empty());
+}
+
+TEST_F(TestRouteHandler, nonFiniteTown05RouteCostFailsClosed)
+{
+  route_handler_->setMap(make_non_finite_town05_route_map());
+  constexpr double half_pi = 1.5707963267948966;
+  const auto start = autoware::test_utils::createPose(2.0, 5.0, 0.0, 0.0, 0.0, half_pi);
+  const auto goal = autoware::test_utils::createPose(2.0, 25.0, 0.0, 0.0, 0.0, half_pi);
+  lanelet::ConstLanelets path{route_handler_->getLaneletsFromId(22775)};
+
+  EXPECT_FALSE(route_handler_->planPathLaneletsBetweenCheckpoints(start, goal, &path));
+  EXPECT_TRUE(path.empty());
+}
