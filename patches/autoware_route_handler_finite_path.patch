+bool has_finite_centerline(const lanelet::ConstLanelet & lanelet)
+{
+  const auto & centerline = lanelet.centerline();
+  if (centerline.size() < 2) {
+    return false;
+  }
+  return std::all_of(centerline.begin(), centerline.end(), [](const auto & point) {
+    return std::isfinite(point.x()) && std::isfinite(point.y()) && std::isfinite(point.z());
+  });
+}
+
+bool has_finite_lanelet_path(const lanelet::routing::LaneletPath & path)
+{
+  return !path.empty() && std::all_of(path.begin(), path.end(), has_finite_centerline);
+}
+
+bool has_finite_lanelet_path(const lanelet::routing::LaneletOrAreaPath & path)
+{
+  if (path.empty()) {
+    return false;
+  }
+  return std::all_of(path.begin(), path.end(), [](const auto & element) {
+    return !element.isLanelet() ||
+           has_finite_centerline(static_cast<const lanelet::ConstLanelet &>(element));
+  });
+}
