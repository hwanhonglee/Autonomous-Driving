+BEVShiftMode parse_bev_shift_mode(const std::string & mode)
+{
+  if (mode == "legacy") {
+    return BEVShiftMode::Legacy;
+  }
+  if (mode == "ros_corrected") {
+    return BEVShiftMode::RosCorrected;
+  }
+  if (mode == "zero") {
+    return BEVShiftMode::Zero;
+  }
+  throw std::invalid_argument(
+    "Unsupported BEV shift mode '" + mode + "'. Expected one of: legacy, ros_corrected, zero");
+}
