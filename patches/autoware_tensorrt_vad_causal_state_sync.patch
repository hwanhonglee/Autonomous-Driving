+  buffer.set_kinematic_state(make_odometry(causal_stamp_ns));
+  EXPECT_EQ(buffer.take_ready_frame().status.reason, FrameAssemblyReason::MISSING_ACCELERATION);
+  buffer.set_acceleration(make_acceleration(causal_stamp_ns));
+  const auto first = buffer.take_ready_frame();
