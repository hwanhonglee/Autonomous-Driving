+TEST(FrameAssembly, SelectsLatestCausalVehicleStateDespiteOutOfOrderCallbacks)
+{
+  auto buffer = make_buffer();
+  set_camera_infos(buffer);
+  constexpr std::int64_t anchor_stamp_ns = 2500000000LL;
+  constexpr std::int64_t future_stamp_ns = anchor_stamp_ns + 50000000LL;
+  constexpr std::int64_t older_causal_stamp_ns = anchor_stamp_ns - 100000000LL;
+  constexpr std::int64_t latest_causal_stamp_ns = anchor_stamp_ns - 50000000LL;
+
+  for (std::size_t camera_id = 0; camera_id < camera_count; ++camera_id) {
+    buffer.set_image(camera_id, make_image(anchor_stamp_ns));
+  }
+  buffer.set_kinematic_state(make_odometry(future_stamp_ns));
+  buffer.set_acceleration(make_acceleration(future_stamp_ns));
+  buffer.set_kinematic_state(make_odometry(latest_causal_stamp_ns));
+  buffer.set_acceleration(make_acceleration(latest_causal_stamp_ns));
+  buffer.set_kinematic_state(make_odometry(older_causal_stamp_ns));
+  buffer.set_acceleration(make_acceleration(older_causal_stamp_ns));
+
+  const auto result = buffer.take_ready_frame();
+  ASSERT_TRUE(result.frame.has_value());
+  ASSERT_NE(result.frame->kinematic_state, nullptr);
+  ASSERT_NE(result.frame->acceleration, nullptr);
+  EXPECT_EQ(result.frame->kinematic_state->header.stamp, make_stamp(latest_causal_stamp_ns));
+  EXPECT_EQ(result.frame->acceleration->header.stamp, make_stamp(latest_causal_stamp_ns));
+  EXPECT_DOUBLE_EQ(result.status.kinematic_state_delta_ms, 50.0);
+  EXPECT_DOUBLE_EQ(result.status.acceleration_delta_ms, 50.0);
+  EXPECT_EQ(buffer.counters().rejected_old_kinematic_states, 0U);
+  EXPECT_EQ(buffer.counters().rejected_old_accelerations, 0U);
+}
