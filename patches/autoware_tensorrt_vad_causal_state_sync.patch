+nav_msgs::msg::Odometry::ConstSharedPtr SynchronizedFrameBuffer::find_latest_causal_kinematic_state(
+  const std::int64_t anchor_stamp_ns) const
+{
+  const auto after_anchor = kinematic_states_.upper_bound(anchor_stamp_ns);
+  if (after_anchor == kinematic_states_.begin()) {
+    return nullptr;
+  }
+  return std::prev(after_anchor)->second;
+}
+
+geometry_msgs::msg::AccelWithCovarianceStamped::ConstSharedPtr
+SynchronizedFrameBuffer::find_latest_causal_acceleration(const std::int64_t anchor_stamp_ns) const
+{
+  const auto after_anchor = accelerations_.upper_bound(anchor_stamp_ns);
+  if (after_anchor == accelerations_.begin()) {
+    return nullptr;
+  }
+  return std::prev(after_anchor)->second;
+}
