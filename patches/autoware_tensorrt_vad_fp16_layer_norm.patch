+TEST(LayerNormPrecision, MatchesOnnxLayerNormDecompositionNames)
+{
+  const std::vector<std::string> matching_names = {
+    "/transformer/can_bus_mlp/norm/ReduceMean",    "/transformer/encoder/layers.0/norms.2/Pow",
+    "/transformer/decoder/layers.1/norms.0/Div",   "/transformer/map_decoder/layers.2/norms.1/Sqrt",
+    "/motion_decoder/layers.0/norms.1/ReduceMean", "/motion_map_decoder/layers.0/norms.1/Mul",
+    "/ego_agent_decoder/layers.0/norms.1/Add",     "/ego_map_decoder/layers.0/norms.1/Sub",
+  };
+
+  for (const auto & name : matching_names) {
+    EXPECT_TRUE(is_layer_norm_related_layer(name, nvinfer1::LayerType::kELEMENTWISE)) << name;
+  }
+
+  EXPECT_TRUE(
+    is_layer_norm_related_layer("/opaque_native_node", nvinfer1::LayerType::kNORMALIZATION));
+}
+
+TEST(LayerNormPrecision, RejectsOtherHeadLayersAndNormalizationWords)
+{
+  const std::vector<std::string> other_names = {
+    "/transformer/encoder/layers.0/attentions.0/Add",
+    "/trajectory/normalized_coordinates/Mul",
+    "/object_head/normalization_factor/Div",
+    "/backbone/normals/Gather",
+  };
+
+  for (const auto & name : other_names) {
+    EXPECT_FALSE(is_layer_norm_related_layer(name, nvinfer1::LayerType::kELEMENTWISE)) << name;
+  }
+}
+
+TEST(LayerNormPrecision, AppliesOnlyToFp16HeadNetworks)
+{
+  EXPECT_TRUE(should_force_layer_norm_fp32(NetworkType::HEAD, "fp16"));
+  EXPECT_TRUE(should_force_layer_norm_fp32(NetworkType::HEAD_NO_PREV, "fp16"));
+  EXPECT_FALSE(should_force_layer_norm_fp32(NetworkType::BACKBONE, "fp16"));
+  EXPECT_FALSE(should_force_layer_norm_fp32(NetworkType::HEAD, "fp32"));
+  EXPECT_FALSE(should_force_layer_norm_fp32(NetworkType::HEAD_NO_PREV, "int8"));
+}
