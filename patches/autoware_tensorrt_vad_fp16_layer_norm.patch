+std::size_t force_layer_norm_layers_fp32(nvinfer1::INetworkDefinition & network)
+{
+  std::size_t forced_layers = 0;
+  for (int32_t index = 0; index < network.getNbLayers(); ++index) {
+    auto * layer = network.getLayer(index);
+    if (layer == nullptr) {
+      continue;
+    }
+    const char * layer_name = layer->getName();
+    const std::string_view name = layer_name != nullptr ? layer_name : "";
+    if (!is_layer_norm_related_layer(name, layer->getType())) {
+      continue;
+    }
+
+    layer->setPrecision(nvinfer1::DataType::kFLOAT);
+    for (int32_t output_index = 0; output_index < layer->getNbOutputs(); ++output_index) {
+      auto * output = layer->getOutput(output_index);
+      if (
+        output != nullptr && (output->getType() == nvinfer1::DataType::kFLOAT ||
+                              output->getType() == nvinfer1::DataType::kHALF)) {
+        layer->setOutputType(output_index, nvinfer1::DataType::kFLOAT);
+      }
+    }
+    ++forced_layers;
+  }
+  return forced_layers;
+}
