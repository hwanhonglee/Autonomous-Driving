+bool is_layer_norm_related_layer(std::string_view layer_name, nvinfer1::LayerType layer_type)
+{
+  return layer_type == nvinfer1::LayerType::kNORMALIZATION ||
+         layer_name.find("/norm/") != std::string_view::npos ||
+         layer_name.find("/norms.") != std::string_view::npos;
+}
+
+bool should_force_layer_norm_fp32(NetworkType network_type, const std::string & precision)
+{
+  return precision == "fp16" &&
+         (network_type == NetworkType::HEAD || network_type == NetworkType::HEAD_NO_PREV);
+}
