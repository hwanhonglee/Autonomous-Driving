+#ifndef RUNTIME_STARTUP_HPP_
+#define RUNTIME_STARTUP_HPP_
+
+#include <functional>
+
+namespace autoware::tensorrt_vad
+{
+
+/**
+ * @brief Enforces the VAD runtime startup order.
+ *
+ * TensorRT initialization is deliberately completed before creating sensor subscriptions. This
+ * prevents the standalone single-threaded executor from starting with stale per-camera DDS
+ * backlogs. The worker starts last so a subscription setup exception cannot leave a joinable
+ * thread in a partially constructed node.
+ */
+class VadRuntimeStartup
+{
+public:
+  using Step = std::function<void()>;
+
+  static void run(
+    const Step & initialize_model, const Step & create_subscribers, const Step & start_worker)
+  {
+    initialize_model();
+    create_subscribers();
+    start_worker();
+  }
+};
+
+}  // namespace autoware::tensorrt_vad
+
+#endif  // RUNTIME_STARTUP_HPP_
