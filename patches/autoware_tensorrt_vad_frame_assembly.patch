+sensor_msgs::msg::Image::ConstSharedPtr SynchronizedFrameBuffer::find_nearest_image_for_diagnostics(
+  const std::size_t camera_id, const std::int64_t anchor_stamp_ns) const
+{
+  if (camera_id >= static_cast<std::size_t>(num_cameras_)) {
+    return nullptr;
+  }
+  sensor_msgs::msg::Image::ConstSharedPtr nearest;
+  std::int64_t nearest_stamp_ns = 0;
+  bool has_nearest = false;
+  for (const auto & [slot_stamp_ns, slot] : pending_frames_) {
+    const auto & image = slot.images[camera_id];
+    if (!image) {
+      continue;
+    }
+    const auto candidate_delta = absolute_stamp_delta(slot_stamp_ns, anchor_stamp_ns);
+    const auto nearest_delta = absolute_stamp_delta(nearest_stamp_ns, anchor_stamp_ns);
+    if (
+      !has_nearest || candidate_delta < nearest_delta ||
+      (candidate_delta == nearest_delta && slot_stamp_ns < nearest_stamp_ns)) {
+      nearest = image;
+      nearest_stamp_ns = slot_stamp_ns;
+      has_nearest = true;
+    }
+  }
+  return nearest;
+}
