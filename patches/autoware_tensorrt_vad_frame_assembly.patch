+TEST(FrameAssembly, LatestMailboxBoundsAgeWhenFiveHertzInputFeedsTwoHertzInference)
+{
+  auto buffer = make_buffer();
+  set_camera_infos(buffer);
+  LatestFrameMailbox mailbox;
+
+  constexpr std::int64_t base_stamp_ns = 10000000000LL;
+  constexpr std::int64_t camera_period_ms = 200;
+  constexpr std::int64_t inference_period_ms = 500;
+  constexpr std::int64_t stress_duration_ms = 5000;
+  std::vector<std::int64_t> taken_source_stamps;
+  double maximum_age_at_inference_start_ms = 0.0;
+
+  for (std::int64_t wall_time_ms = 0; wall_time_ms <= stress_duration_ms; wall_time_ms += 100) {
+    if (wall_time_ms % camera_period_ms == 0) {
+      const auto source_stamp_ns = base_stamp_ns + wall_time_ms * 1000000LL;
+      auto assembled = feed_dynamic_frame_as_callbacks(buffer, source_stamp_ns);
+      ASSERT_EQ(assembled.size(), 1U);
+      EXPECT_EQ(assembled.front().status.image_stamp_span_ms, 0.0);
+      const auto submit_result = mailbox.submit(std::move(assembled.front()));
+      EXPECT_TRUE(
+        submit_result == FrameMailboxSubmitResult::STORED ||
+        submit_result == FrameMailboxSubmitResult::REPLACED_OLDER_PENDING);
+    }
+
+    // A serial worker becomes ready for its next frame every 500 ms.
+    if (wall_time_ms % inference_period_ms == 0) {
+      auto work = mailbox.take_latest();
+      ASSERT_TRUE(work.has_value());
+      const auto age_ms =
+        static_cast<double>(
+          base_stamp_ns + wall_time_ms * 1000000LL - work->status.source_stamp_ns) /
+        1000000.0;
+      maximum_age_at_inference_start_ms = std::max(maximum_age_at_inference_start_ms, age_ms);
+      taken_source_stamps.push_back(work->status.source_stamp_ns);
+    }
+  }
+
+  EXPECT_TRUE(std::is_sorted(taken_source_stamps.begin(), taken_source_stamps.end()));
+  EXPECT_EQ(
+    std::adjacent_find(taken_source_stamps.begin(), taken_source_stamps.end()),
+    taken_source_stamps.end());
+  EXPECT_LE(maximum_age_at_inference_start_ms, static_cast<double>(camera_period_ms));
+  EXPECT_LE(maximum_age_at_inference_start_ms + static_cast<double>(inference_period_ms), 700.0);
+  EXPECT_EQ(mailbox.counters().submitted, 26U);
+  EXPECT_EQ(mailbox.counters().taken, 11U);
+  EXPECT_EQ(mailbox.counters().coalesced_drops, 15U);
+  EXPECT_EQ(mailbox.counters().rejected_old, 0U);
+  EXPECT_FALSE(mailbox.has_pending());
+}
