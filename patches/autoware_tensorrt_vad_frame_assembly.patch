+  const std::array<std::size_t, camera_count> camera_order{0, 3, 1, 5, 2, 4};
+  for (const auto camera_id : camera_order) {
+    for (std::size_t callback_index = 0; callback_index < source_stamps.size(); ++callback_index) {
+      const auto stamp_index =
+        camera_id % 2U == 0U ? callback_index : source_stamps.size() - callback_index - 1U;
+      buffer.set_image(camera_id, make_image(source_stamps[stamp_index]));
+      EXPECT_FALSE(buffer.take_ready_frame().frame.has_value());
+    }
+  }
+
+  ASSERT_EQ(buffer.pending_frame_count(), source_stamps.size());
+  EXPECT_EQ(buffer.oldest_pending_source_stamp_ns(), source_stamps.front());
+  EXPECT_EQ(buffer.newest_pending_source_stamp_ns(), source_stamps.back());
+
+  buffer.set_kinematic_state(make_odometry(source_stamps.back()));
+  EXPECT_FALSE(buffer.take_ready_frame().frame.has_value());
+  buffer.set_acceleration(make_acceleration(source_stamps.back()));
+  const auto newest = buffer.take_ready_frame();
+  ASSERT_TRUE(newest.frame.has_value());
+  EXPECT_EQ(newest.status.source_stamp_ns, source_stamps.back());
+  EXPECT_DOUBLE_EQ(newest.status.image_stamp_span_ms, 0.0);
+  for (const auto & image : newest.frame->images) {
+    ASSERT_NE(image, nullptr);
+    EXPECT_EQ(image->header.stamp, make_stamp(source_stamps.back()));
+  }
+  for (const auto & camera_info : newest.frame->camera_infos) {
+    EXPECT_NE(camera_info, nullptr);
+  }
+  EXPECT_EQ(buffer.pending_frame_count(), 0U);
+  EXPECT_EQ(buffer.counters().accepted_frames, 1U);
+  EXPECT_EQ(buffer.counters().superseded_frames, source_stamps.size() - 1U);
+  EXPECT_EQ(buffer.counters().capacity_pruned_frames, 0U);
+}
+
+TEST(FrameAssembly, BoundsTimestampSlotsAndPrunesOldestIncompleteFrames)
+{
+  auto buffer = make_buffer(3U);
+  set_camera_infos(buffer);
+  constexpr std::int64_t base_stamp_ns = 30000000000LL;
+  constexpr std::int64_t period_ns = 200000000LL;
+
+  for (std::size_t index = 0; index < 5U; ++index) {
+    buffer.set_image(0, make_image(base_stamp_ns + static_cast<std::int64_t>(index) * period_ns));
+  }
+  EXPECT_EQ(buffer.pending_frame_count(), 3U);
+  EXPECT_EQ(buffer.counters().capacity_pruned_frames, 2U);
+  EXPECT_EQ(buffer.oldest_pending_source_stamp_ns(), base_stamp_ns + 2 * period_ns);
+  EXPECT_EQ(buffer.newest_pending_source_stamp_ns(), base_stamp_ns + 4 * period_ns);
+
+  const auto newest_stamp_ns = base_stamp_ns + 4 * period_ns;
+  for (std::size_t camera_id = 1; camera_id < camera_count; ++camera_id) {
+    buffer.set_image(camera_id, make_image(newest_stamp_ns));
+  }
+  buffer.set_kinematic_state(make_odometry(newest_stamp_ns));
+  buffer.set_acceleration(make_acceleration(newest_stamp_ns));
+  const auto newest = buffer.take_ready_frame();
+  ASSERT_TRUE(newest.frame.has_value());
+  EXPECT_EQ(newest.status.source_stamp_ns, newest_stamp_ns);
+  EXPECT_EQ(buffer.pending_frame_count(), 0U);
+  EXPECT_EQ(buffer.counters().capacity_pruned_frames, 2U);
+  EXPECT_EQ(buffer.counters().superseded_frames, 2U);
+}
+
