+  constexpr std::int64_t base_stamp_ns = 5000000000LL;
+  constexpr std::int64_t period_ns = 200000000LL;
+  constexpr std::size_t frame_count = 12U;
+  std::vector<std::int64_t> accepted_stamps;
+
+  const auto take_if_ready = [&]() {
+    auto result = buffer.take_ready_frame();
+    if (result.frame.has_value()) {
+      EXPECT_EQ(result.match_kind, FrameAssemblyResult::MatchKind::EXACT_TIMESTAMP);
+      EXPECT_DOUBLE_EQ(result.status.image_stamp_span_ms, 0.0);
+      accepted_stamps.push_back(result.status.source_stamp_ns);
+    }
+  };
+
+  for (std::size_t frame_index = 0; frame_index < frame_count; ++frame_index) {
+    const auto current_stamp_ns =
+      base_stamp_ns + static_cast<std::int64_t>(frame_index) * period_ns;
+    buffer.set_kinematic_state(make_odometry(current_stamp_ns));
+    take_if_ready();
+    buffer.set_acceleration(make_acceleration(current_stamp_ns));
+    take_if_ready();
+    for (std::size_t camera_id = 0; camera_id < camera_count - 1U; ++camera_id) {
+      buffer.set_image(camera_id, make_image(current_stamp_ns));
+      take_if_ready();
+    }
+    if (frame_index > 0U) {
+      buffer.set_image(camera_count - 1U, make_image(current_stamp_ns - period_ns));
+      take_if_ready();
+    }
+  }
+
+  const auto flush_state_stamp_ns =
+    base_stamp_ns + static_cast<std::int64_t>(frame_count) * period_ns;
+  buffer.set_kinematic_state(make_odometry(flush_state_stamp_ns));
+  take_if_ready();
+  buffer.set_acceleration(make_acceleration(flush_state_stamp_ns));
+  take_if_ready();
+  buffer.set_image(
+    camera_count - 1U,
+    make_image(base_stamp_ns + static_cast<std::int64_t>(frame_count - 1U) * period_ns));
+  take_if_ready();
+
+  ASSERT_EQ(accepted_stamps.size(), frame_count);
+  for (std::size_t frame_index = 0; frame_index < frame_count; ++frame_index) {
+    EXPECT_EQ(
+      accepted_stamps[frame_index],
+      base_stamp_ns + static_cast<std::int64_t>(frame_index) * period_ns);
+  }
+  EXPECT_EQ(buffer.counters().accepted_frames, frame_count);
+  EXPECT_EQ(buffer.counters().capacity_pruned_frames, 0U);
+  EXPECT_EQ(buffer.counters().superseded_frames, 0U);
+  EXPECT_EQ(buffer.counters().rejected_old_images, 0U);
+  for (std::size_t camera_id = 0; camera_id < camera_count; ++camera_id) {
+    EXPECT_EQ(buffer.counters().received_images_by_camera[camera_id], frame_count);
+  }
+  EXPECT_EQ(buffer.pending_frame_count(), 0U);
+}
