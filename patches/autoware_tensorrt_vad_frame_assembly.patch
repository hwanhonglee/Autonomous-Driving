+  }
+  frame.camera_infos = camera_infos_;
+  frame.kinematic_state = kinematic_state_;
+  frame.acceleration = acceleration_;
+  const auto & anchor_image = frame.images[anchor_camera_id_];
+  if (anchor_image) {
+    frame.stamp = rclcpp::Time(anchor_image->header.stamp);
+  }
+  return frame;
+}
+
+FrameAssemblyResult SynchronizedFrameBuffer::find_newest_exact_frame() const
+{
+  FrameAssemblyResult newest_result;
+  bool has_result = false;
+  for (auto frame_it = pending_frames_.crbegin(); frame_it != pending_frames_.crend(); ++frame_it) {
+    auto candidate = materialize_exact_frame(frame_it->second);
+    auto status = synchronization_strategy_->evaluate(candidate);
+    if (!has_result) {
+      newest_result.status = status;
+      has_result = true;
+    }
+    if (status.ready()) {
+      return FrameAssemblyResult{
+        status, std::move(candidate), FrameAssemblyResult::MatchKind::EXACT_TIMESTAMP};
+    }
+  }
+
+  if (!has_result) {
+    VadInputTopicData empty_frame(num_cameras_);
+    newest_result.status =
+      synchronization_strategy_->evaluate(materialize_exact_frame(empty_frame));
+  }
+  return newest_result;
+}
+
+FrameAssemblyResult SynchronizedFrameBuffer::find_newest_approximate_frame() const
+{
+  FrameAssemblyResult newest_diagnostic;
+  for (auto frame_it = pending_frames_.crbegin(); frame_it != pending_frames_.crend(); ++frame_it) {
+    if (!frame_it->second.images[anchor_camera_id_]) {
+      continue;
+    }
+    auto candidate = materialize_approximate_frame(frame_it->first);
+    auto status = synchronization_strategy_->evaluate(candidate);
+    if (status.ready()) {
+      return FrameAssemblyResult{
+        status, std::move(candidate), FrameAssemblyResult::MatchKind::APPROXIMATE};
+    }
+    if (newest_diagnostic.match_kind == FrameAssemblyResult::MatchKind::NONE) {
+      auto diagnostic_candidate = materialize_approximate_diagnostic_frame(frame_it->first);
+      newest_diagnostic.status = synchronization_strategy_->evaluate(diagnostic_candidate);
+      newest_diagnostic.match_kind = FrameAssemblyResult::MatchKind::APPROXIMATE;
+    }
+  }
+  return newest_diagnostic;
+}
+
+FrameAssemblyResult SynchronizedFrameBuffer::find_newest_ready_frame() const
+{
+  auto exact_result = find_newest_exact_frame();
+  if (exact_result.frame.has_value()) {
+    return exact_result;
+  }
+  auto approximate_result = find_newest_approximate_frame();
+  return approximate_result.match_kind == FrameAssemblyResult::MatchKind::APPROXIMATE
+           ? std::move(approximate_result)
+           : exact_result;
+}
+
+void SynchronizedFrameBuffer::prune_to_capacity()
+{
+  while (pending_frames_.size() > max_pending_frames_) {
+    pending_frames_.erase(pending_frames_.begin());
+    ++counters_.capacity_pruned_frames;
+  }
+}
+
+void SynchronizedFrameBuffer::consume_exact_frame(const std::int64_t chosen_stamp_ns)
+{
+  auto erase_end = pending_frames_.upper_bound(chosen_stamp_ns);
+  for (auto frame_it = pending_frames_.begin(); frame_it != erase_end; ++frame_it) {
+    if (frame_it->first != chosen_stamp_ns) {
+      ++counters_.superseded_frames;
+    }
+  }
+  pending_frames_.erase(pending_frames_.begin(), erase_end);
+}
+
+void SynchronizedFrameBuffer::consume_approximate_frame(const FrameAssemblyResult & result)
+{
+  const auto chosen_stamp_ns = result.status.source_stamp_ns;
+  consume_exact_frame(chosen_stamp_ns);
+  for (std::size_t camera_id = 0; camera_id < static_cast<std::size_t>(num_cameras_); ++camera_id) {
+    const auto & selected_image = result.frame->images[camera_id];
+    const auto selected_stamp_ns = stamp_to_nanoseconds(selected_image->header.stamp);
+    approximate_consumed_watermarks_ns_[camera_id] = std::max(chosen_stamp_ns, selected_stamp_ns);
+    if (selected_stamp_ns <= chosen_stamp_ns) {
+      continue;
+    }
+    const auto selected_slot = pending_frames_.find(selected_stamp_ns);
+    if (selected_slot == pending_frames_.end()) {
+      continue;
+    }
+    selected_slot->second.images[camera_id].reset();
+    const bool slot_empty = std::none_of(
+      selected_slot->second.images.begin(), selected_slot->second.images.end(),
+      [](const auto & image) { return image != nullptr; });
+    if (slot_empty) {
+      pending_frames_.erase(selected_slot);
+    }
+  }
+}
+
+FrameAssemblyStatus SynchronizedFrameBuffer::evaluate() const
+{
+  return find_newest_ready_frame().status;
+}
+
+FrameAssemblyResult SynchronizedFrameBuffer::take_ready_frame()
+{
+  auto result = find_newest_ready_frame();
+  if (!result.frame.has_value()) {
+    return result;
+  }
+
+  const auto chosen_stamp_ns = result.status.source_stamp_ns;
+  if (result.match_kind == FrameAssemblyResult::MatchKind::APPROXIMATE) {
+    consume_approximate_frame(result);
+  } else {
+    consume_exact_frame(chosen_stamp_ns);
+  }
+
+  // Vehicle state remains single-use as in the original reset-on-accept behavior.
+  kinematic_state_.reset();
+  acceleration_.reset();
+  last_accepted_source_stamp_ns_ = chosen_stamp_ns;
+  ++counters_.accepted_frames;
+  return result;
+}
+
+std::optional<std::int64_t> SynchronizedFrameBuffer::oldest_pending_source_stamp_ns() const
+{
+  if (pending_frames_.empty()) {
+    return std::nullopt;
+  }
+  return pending_frames_.begin()->first;
+}
+
+std::optional<std::int64_t> SynchronizedFrameBuffer::newest_pending_source_stamp_ns() const
+{
+  if (pending_frames_.empty()) {
+    return std::nullopt;
+  }
+  return pending_frames_.rbegin()->first;
 }

 }  // namespace autoware::tensorrt_vad
