+const char * to_string(const FrameAssemblyReason reason)
+{
+  switch (reason) {
+    case FrameAssemblyReason::READY:
+      return "ready";
+    case FrameAssemblyReason::INVALID_CONFIGURATION:
+      return "invalid_configuration";
+    case FrameAssemblyReason::MISSING_FRONT_IMAGE:
+      return "missing_front_image";
+    case FrameAssemblyReason::MISSING_IMAGES:
+      return "missing_images";
+    case FrameAssemblyReason::MISSING_CAMERA_INFO:
+      return "missing_camera_info";
+    case FrameAssemblyReason::MISSING_KINEMATIC_STATE:
+      return "missing_kinematic_state";
+    case FrameAssemblyReason::MISSING_ACCELERATION:
+      return "missing_acceleration";
+    case FrameAssemblyReason::IMAGE_STAMP_MISMATCH:
+      return "image_stamp_mismatch";
+    case FrameAssemblyReason::KINEMATIC_STATE_STAMP_MISMATCH:
+      return "kinematic_state_stamp_mismatch";
+    case FrameAssemblyReason::ACCELERATION_STAMP_MISMATCH:
+      return "acceleration_stamp_mismatch";
+    case FrameAssemblyReason::DUPLICATE_OR_OLD_FRAME:
+      return "duplicate_or_old_frame";
+    case FrameAssemblyReason::COUNT:
+      return "invalid_reason";
+  }
+  return "invalid_reason";
+}

