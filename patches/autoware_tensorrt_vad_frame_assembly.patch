+std::int64_t stamp_to_nanoseconds(const builtin_interfaces::msg::Time & stamp)
+{
+  return static_cast<std::int64_t>(stamp.sec) * 1000000000LL +
+         static_cast<std::int64_t>(stamp.nanosec);
+}
+
+double stamp_delta_ms(std::int64_t lhs, std::int64_t rhs)
+{
+  return std::abs(static_cast<double>(lhs - rhs)) / 1000000.0;
+}
+
+std::int64_t subtract_saturated(const std::int64_t value, const std::int64_t delta)
+{
+  const auto minimum = std::numeric_limits<std::int64_t>::min();
+  return value < minimum + delta ? minimum : value - delta;
+}
+
+std::int64_t add_saturated(const std::int64_t value, const std::int64_t delta)
+{
+  const auto maximum = std::numeric_limits<std::int64_t>::max();
+  return value > maximum - delta ? maximum : value + delta;
+}
+
+std::uint64_t absolute_stamp_delta(const std::int64_t lhs, const std::int64_t rhs)
+{
+  if (lhs >= rhs) {
+    return static_cast<std::uint64_t>(lhs) - static_cast<std::uint64_t>(rhs);
+  }
+  return static_cast<std::uint64_t>(rhs) - static_cast<std::uint64_t>(lhs);
+}
+
+std::uint64_t expected_mask(std::size_t size)
+{
+  if (size >= std::numeric_limits<std::uint64_t>::digits) {
+    return std::numeric_limits<std::uint64_t>::max();
+  }
+  return (std::uint64_t{1} << size) - 1U;
+}
+
+}  // namespace
