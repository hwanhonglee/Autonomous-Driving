+void validate_bbox_contract(const BBox & bbox)
+{
+  for (const auto value : bbox.bbox) {
+    if (!std::isfinite(value)) {
+      throw std::invalid_argument("VAD bbox contains a non-finite value");
+    }
+  }
+  if (!std::isfinite(bbox.confidence)) {
+    throw std::invalid_argument("VAD bbox confidence is non-finite");
+  }
+  if (bbox.bbox[2] <= 0.0F || bbox.bbox[3] <= 0.0F || bbox.bbox[5] <= 0.0F) {
+    throw std::invalid_argument("VAD bbox dimensions must be positive");
+  }
+  if (std::hypot(bbox.bbox[6], bbox.bbox[7]) <= std::numeric_limits<float>::epsilon()) {
+    throw std::invalid_argument(
+      std::string{kObjectYawContract} + ": VAD bbox orientation vector is degenerate");
+  }
+  for (const auto & trajectory : bbox.trajectories) {
+    if (!std::isfinite(trajectory.confidence)) {
+      throw std::invalid_argument("VAD object trajectory confidence is non-finite");
+    }
+    for (const auto & point : trajectory.trajectory) {
+      if (!std::isfinite(point[0]) || !std::isfinite(point[1])) {
+        throw std::invalid_argument("VAD object trajectory contains a non-finite value");
+      }
+    }
+  }
+}
