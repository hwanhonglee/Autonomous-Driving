+{
+namespace
+{
+constexpr double kPi = 3.14159265358979323846;
+constexpr double kTolerance = 1.0e-5;
+
+double yaw_error(const double actual, const double expected)
+{
+  return std::atan2(std::sin(actual - expected), std::cos(actual - expected));
+}
+
+double quaternion_yaw(const geometry_msgs::msg::Quaternion & quaternion)
+{
+  const double sin_yaw = 2.0 * (quaternion.w * quaternion.z + quaternion.x * quaternion.y);
+  const double cos_yaw = 1.0 - 2.0 * (quaternion.y * quaternion.y + quaternion.z * quaternion.z);
+  return std::atan2(sin_yaw, cos_yaw);
+}
+
+Eigen::Matrix4d transform_with_yaw(const double yaw)
+{
+  Eigen::Matrix4d transform = Eigen::Matrix4d::Identity();
+  transform(0, 0) = std::cos(yaw);
+  transform(0, 1) = -std::sin(yaw);
+  transform(1, 0) = std::sin(yaw);
+  transform(1, 1) = std::cos(yaw);
+  return transform;
+}
+
+BBox make_bbox(const double second_yaw)
+{
+  BBox bbox;
+  bbox.bbox = {
+    12.0F,
+    3.0F,
+    1.8F,
+    4.8F,
+    0.0F,
+    1.5F,
+    static_cast<float>(std::sin(second_yaw)),
+    static_cast<float>(std::cos(second_yaw)),
+    0.0F,
+    0.0F};
+  bbox.confidence = 0.9F;
+  bbox.object_class = 0;
+  return bbox;
+}
+
+class ObjectsConverterOrientationTest : public ::testing::Test
+{
+protected:
+  ObjectsConverterOrientationTest()
+  : transformer_(nullptr),
+    config_(
+      640, 384, {-50.0, -50.0, -5.0, 50.0, 50.0, 5.0}, "legacy_zero", 2, {}, {}, {"CAR"}, {"car"}),
+    converter_(transformer_, config_)
+  {
+  }
+
+  autoware_perception_msgs::msg::PredictedObject convert(
+    const BBox & bbox, const Eigen::Matrix4d & transform = Eigen::Matrix4d::Identity()) const
+  {
+    const auto objects =
+      converter_.process_predicted_objects({bbox}, rclcpp::Time(1, 0), transform);
+    EXPECT_EQ(objects.objects.size(), 1U);
+    return objects.objects.at(0);
+  }
+
+  CoordinateTransformer transformer_;
+  VadInterfaceConfig config_;
+  OutputObjectsConverter converter_;
+};
+
+TEST_F(ObjectsConverterOrientationTest, AppliesOfficialBench2DriveSecondYawConvention)
+{
+  struct Case
+  {
+    double second_yaw;
+    double expected_physical_yaw;
+  };
+  const std::vector<Case> cases = {
+    {0.0, -kPi / 2.0},
+    {kPi / 2.0, -kPi},
+    {-kPi / 2.0, 0.0},
+    {kPi, kPi / 2.0},
+  };
+
+  for (const auto & test_case : cases) {
+    const auto object = convert(make_bbox(test_case.second_yaw));
+    const double actual_yaw =
+      quaternion_yaw(object.kinematics.initial_pose_with_covariance.pose.orientation);
+    EXPECT_NEAR(yaw_error(actual_yaw, test_case.expected_physical_yaw), 0.0, kTolerance);
+  }
+}
+
+TEST_F(ObjectsConverterOrientationTest, AddsBaseToMapYawAfterConventionConversion)
+{
+  constexpr double second_yaw = -kPi / 2.0;
+  constexpr double transform_yaw = kPi / 3.0;
+  const auto object = convert(make_bbox(second_yaw), transform_with_yaw(transform_yaw));
+  const double actual_yaw =
+    quaternion_yaw(object.kinematics.initial_pose_with_covariance.pose.orientation);
+
+  EXPECT_NEAR(yaw_error(actual_yaw, transform_yaw), 0.0, kTolerance);
+}
+
+TEST_F(ObjectsConverterOrientationTest, KeepsLengthOnThePhysicalLongAxis)
+{
+  const auto object = convert(make_bbox(-kPi / 2.0));
+  const double yaw =
+    quaternion_yaw(object.kinematics.initial_pose_with_covariance.pose.orientation);
+  const double longitudinal_half_extent =
+    std::abs(std::cos(yaw)) * object.shape.dimensions.x / 2.0 +
+    std::abs(std::sin(yaw)) * object.shape.dimensions.y / 2.0;
+  const double lateral_half_extent = std::abs(std::sin(yaw)) * object.shape.dimensions.x / 2.0 +
+                                     std::abs(std::cos(yaw)) * object.shape.dimensions.y / 2.0;
+
+  EXPECT_FLOAT_EQ(object.shape.dimensions.x, 4.8F);
+  EXPECT_FLOAT_EQ(object.shape.dimensions.y, 1.8F);
+  EXPECT_NEAR(longitudinal_half_extent, 2.4, kTolerance);
+  EXPECT_NEAR(lateral_half_extent, 0.9, kTolerance);
+}
+
+TEST_F(ObjectsConverterOrientationTest, RejectsNonFiniteOrDegenerateOrientation)
+{
+  auto non_finite_sin = make_bbox(0.0);
+  non_finite_sin.bbox[6] = std::numeric_limits<float>::quiet_NaN();
+  EXPECT_THROW(convert(non_finite_sin), std::invalid_argument);
+
+  auto non_finite_cos = make_bbox(0.0);
+  non_finite_cos.bbox[7] = std::numeric_limits<float>::infinity();
+  EXPECT_THROW(convert(non_finite_cos), std::invalid_argument);
+
+  auto degenerate = make_bbox(0.0);
+  degenerate.bbox[6] = 0.0F;
+  degenerate.bbox[7] = 0.0F;
+  EXPECT_THROW(convert(degenerate), std::invalid_argument);
+}
+
+TEST_F(ObjectsConverterOrientationTest, RejectsNonFiniteOrDegenerateMapTransform)
+{
+  Eigen::Matrix4d non_finite = Eigen::Matrix4d::Identity();
+  non_finite(0, 0) = std::numeric_limits<double>::quiet_NaN();
+  EXPECT_THROW(convert(make_bbox(0.0), non_finite), std::invalid_argument);
+
+  Eigen::Matrix4d degenerate = Eigen::Matrix4d::Identity();
+  degenerate(0, 0) = 0.0;
+  degenerate(1, 0) = 0.0;
+  EXPECT_THROW(convert(make_bbox(0.0), degenerate), std::invalid_argument);
+}
