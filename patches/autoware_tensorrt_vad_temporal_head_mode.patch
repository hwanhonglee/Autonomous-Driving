+#ifndef TEMPORAL_HEAD_POLICY_HPP_
+#define TEMPORAL_HEAD_POLICY_HPP_
+
+#include <string_view>
+
+namespace autoware::tensorrt_vad
+{
+
+enum class PrevBevAction { NONE = 0, INITIALIZE, ADVANCE };
+
+struct HeadExecutionPlan
+{
+  std::string_view network_name;
+  PrevBevAction prev_bev_action;
+};
+
+class TemporalHeadPolicy
+{
+public:
+  explicit constexpr TemporalHeadPolicy(const bool enabled) noexcept : enabled_(enabled) {}
+
+  [[nodiscard]] constexpr HeadExecutionPlan plan() const noexcept
+  {
+    if (!enabled_) {
+      return {"head_no_prev", PrevBevAction::NONE};
+    }
+    if (!temporal_state_initialized_) {
+      return {"head_no_prev", PrevBevAction::INITIALIZE};
+    }
+    return {"head", PrevBevAction::ADVANCE};
+  }
+
+  constexpr void commit_successful_inference() noexcept
+  {
+    if (enabled_) {
+      temporal_state_initialized_ = true;
+    }
+  }
+
+  [[nodiscard]] constexpr bool temporal_state_initialized() const noexcept
+  {
+    return temporal_state_initialized_;
+  }
+
+private:
+  bool enabled_;
+  bool temporal_state_initialized_{false};
+};
+
+}  // namespace autoware::tensorrt_vad
+
+#endif  // TEMPORAL_HEAD_POLICY_HPP_
