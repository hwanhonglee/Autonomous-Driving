+
+#include "temporal_head_policy.hpp"
+
+#include <gtest/gtest.h>
+
+namespace autoware::tensorrt_vad
+{
+
+TEST(TemporalHeadPolicy, DefaultTemporalModeSeedsThenAdvancesPrevBev)
+{
+  TemporalHeadPolicy policy(true);
+
+  const auto first = policy.plan();
+  EXPECT_EQ(first.network_name, "head_no_prev");
+  EXPECT_EQ(first.prev_bev_action, PrevBevAction::INITIALIZE);
+
+  policy.commit_successful_inference();
+  const auto second = policy.plan();
+  EXPECT_EQ(second.network_name, "head");
+  EXPECT_EQ(second.prev_bev_action, PrevBevAction::ADVANCE);
+  EXPECT_TRUE(policy.temporal_state_initialized());
+}
+
+TEST(TemporalHeadPolicy, StatelessModeNeverInitializesOrAdvancesPrevBev)
+{
+  TemporalHeadPolicy policy(false);
+
+  for (int frame = 0; frame < 3; ++frame) {
+    const auto plan = policy.plan();
+    EXPECT_EQ(plan.network_name, "head_no_prev");
+    EXPECT_EQ(plan.prev_bev_action, PrevBevAction::NONE);
+    policy.commit_successful_inference();
+    EXPECT_FALSE(policy.temporal_state_initialized());
+  }
+}
+
+TEST(TemporalHeadPolicy, FailedInferenceDoesNotConsumeFirstFrameSemantics)
+{
+  TemporalHeadPolicy policy(true);
+
+  const auto before_failure = policy.plan();
+  EXPECT_EQ(before_failure.prev_bev_action, PrevBevAction::INITIALIZE);
+
+  const auto retry = policy.plan();
+  EXPECT_EQ(retry.network_name, "head_no_prev");
+  EXPECT_EQ(retry.prev_bev_action, PrevBevAction::INITIALIZE);
+  EXPECT_FALSE(policy.temporal_state_initialized());
+}
+
+}  // namespace autoware::tensorrt_vad
