<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vils_interfaces</name>
  <version>0.1.0</version>
  <description>Prototype typed interfaces for the PC2 VILS object acceptance boundary.</description>
  <maintainer email="135099641+hwanhonglee@users.noreply.github.com">hwanhonglee</maintainer>
  <license>Apache License 2.0</license>

  <!-- HH_260810 - Declare only the generators and message dependencies required by the VILS interfaces. -->
  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>autoware_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
