<launch>
  <arg name="interface" default="can0" />
  <arg name="receiver_interval_sec" default="0.01" />
  <arg name="sender_timeout_sec" default="0.01" />
  <arg name="enable_can_fd" default="false" />
  <arg name="from_can_bus_topic" default="/from_can_bus" />
  <arg name="from_can_bus_fd_topic" default="/from_can_bus_fd" />
  <arg name="to_can_bus_topic" default="/to_can_bus" />
  <arg name="to_can_bus_fd_topic" default="/to_can_bus_fd" />
  <arg name="receiver_node_name" default="socket_can_receiver_can0" />
  <arg name="sender_node_name" default="socket_can_sender_can0" />
  <!-- HH_260810 - Split raw SocketCAN transport from the actuator-capable control adapter so each path requires an explicit opt-in. -->
  <arg name="enable_socketcan_bridge" default="false" />
  <arg name="enable_control_adapter" default="false" />

  <!-- HH_260810 - Kept the raw bridge independently selectable for isolated vcan communication tests. -->
  <include file="$(find-pkg-share ros2_socketcan)/launch/socket_can_bridge.launch.xml" if="$(var enable_socketcan_bridge)">
    <arg name="interface" value="$(var interface)" />
    <arg name="receiver_interval_sec" value="$(var receiver_interval_sec)" />
    <arg name="sender_timeout_sec" value="$(var sender_timeout_sec)" />
    <arg name="enable_can_fd" value="$(var enable_can_fd)" />
    <arg name="from_can_bus_topic" value="$(var from_can_bus_topic)" />
    <arg name="from_can_bus_fd_topic" value="$(var from_can_bus_fd_topic)" />
    <arg name="to_can_bus_topic" value="$(var to_can_bus_topic)" />
    <arg name="to_can_bus_fd_topic" value="$(var to_can_bus_fd_topic)" />
    <arg name="receiver_node_name" value="$(var receiver_node_name)" />
    <arg name="sender_node_name" value="$(var sender_node_name)" />
  </include>

  <!-- HH_260810 - Left the control-to-CAN adapter OFF for stationary tests, including when the raw vcan bridge is enabled. -->
  <node pkg="ros2_socketcan" exec="twistController2VCU2EPS2ACC_node" name="twistController2VCU2EPS2ACC_node" output="screen" if="$(var enable_control_adapter)">
    <remap from="to_can_bus" to="$(var to_can_bus_topic)" />
  </node>
</launch>
