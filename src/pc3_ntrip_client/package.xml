<?xml version="1.0"?>
<!-- HH_260811 - Register the isolated PC3 NTRIP correction package. -->
<package format="3">
  <name>pc3_ntrip_client</name>
  <version>0.1.0</version>
  <description>Secure NTRIP client and validated RTCM3 serial bridge for vehicle PC3.</description>
  <!-- HH_260811 - Record the vehicle integration maintainer in ROS package metadata. -->
  <maintainer email="hwanhong57@gmail.com">Hwanhong Lee</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rtcm_msgs</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
