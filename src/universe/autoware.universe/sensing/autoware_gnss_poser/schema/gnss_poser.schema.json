{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parameters for Gnss Poser Node",
  "type": "object",
  "definitions": {
    "gnss_poser": {
      "type": "object",
      "properties": {
        "base_frame": {
          "type": "string",
          "default": "base_link",
          "description": "frame id for base_frame"
        },
        "gnss_base_frame": {
          "type": "string",
          "default": "gnss_base_link",
          "description": "frame id for gnss_base_frame"
        },
        "map_frame": {
          "type": "string",
          "default": "map",
          "description": "frame id for map_frame"
        },
        "use_gnss_ins_orientation": {
          "type": "boolean",
          "default": "true",
          "description": "use Gnss-Ins orientation"
        },
        "gnss_ins_orientation_timeout_sec": {
          "type": "number",
          "default": 1.5,
          "minimum": 0.0,
          "description": "Maximum timestamp difference between a fix and INS attitude. [s]"
        },
        "gnss_ins_orientation_fix_frame": {
          "type": "string",
          "default": "gnss_link",
          "description": "Fix frame allowed to use the INS attitude."
        },
        "allow_position_only_fallback": {
          "type": "boolean",
          "default": true,
          "description": "Publish a broad-yaw position seed when primary INS attitude is unavailable."
        },
        "course_heading_min_distance_m": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.0,
          "description": "Minimum displacement before updating fallback course heading. [m]"
        },
        "position_only_yaw_stddev_rad": {
          "type": "number",
          "default": 3.1622776601683795,
          "exclusiveMinimum": 0.0,
          "description": "Yaw standard deviation for position-only output. [rad]"
        },
        "gnss_pose_pub_method": {
          "type": "integer",
          "default": "0",
          "minimum": 0,
          "maximum": 2,
          "description": "0: Instant Value 1: Average Value 2: Median Value. If 0 is chosen buffer_epoch parameter loses affect."
        },
        "buff_epoch": {
          "type": "integer",
          "default": "1",
          "minimum": 0,
          "description": "Buffer epoch"
        }
      },
      "required": [
        "base_frame",
        "gnss_base_frame",
        "map_frame",
        "use_gnss_ins_orientation",
        "gnss_ins_orientation_timeout_sec",
        "gnss_ins_orientation_fix_frame",
        "allow_position_only_fallback",
        "course_heading_min_distance_m",
        "position_only_yaw_stddev_rad",
        "gnss_pose_pub_method",
        "buff_epoch"
      ]
    }
  },
  "properties": {
    "/**": {
      "type": "object",
      "properties": {
        "ros__parameters": {
          "$ref": "#/definitions/gnss_poser"
        }
      },
      "required": ["ros__parameters"]
    }
  },
  "required": ["/**"]
}
